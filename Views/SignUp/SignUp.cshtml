@model Inventory.Models.SignUpModel
@{
    Layout = "_SignUp_Layout";
    ViewData["Title"] = "Create account";
}

<div class="auth-card">
    <header class="auth-card-header">
        <h2>Create your account</h2>
        <p>Set up your Fluxx workspace access in a minute.</p>
    </header>

    <form asp-action="SignUp" method="post">
        @Html.AntiForgeryToken()
        <div asp-validation-summary="ModelOnly"></div>

        <div class="auth-field-row">
            <div class="auth-field">
                <label asp-for="FirstName"></label>
                <div class="auth-input-wrap">
                    <i class="fas fa-user"></i>
                    <input asp-for="FirstName" class="auth-input"
                           autocomplete="given-name" placeholder="First name" autofocus>
                </div>
                <span asp-validation-for="FirstName"></span>
            </div>

            <div class="auth-field">
                <label asp-for="LastName"></label>
                <div class="auth-input-wrap">
                    <i class="fas fa-user"></i>
                    <input asp-for="LastName" class="auth-input"
                           autocomplete="family-name" placeholder="Last name">
                </div>
                <span asp-validation-for="LastName"></span>
            </div>
        </div>

        <div class="auth-field">
            <label asp-for="Email"></label>
            <div class="auth-input-wrap">
                <i class="fas fa-envelope"></i>
                <input asp-for="Email" class="auth-input" type="email"
                       autocomplete="email" placeholder="name@company.com">
            </div>
            <span asp-validation-for="Email"></span>
        </div>

        <div class="auth-field-row">
            <div class="auth-field">
                <label asp-for="Password"></label>
                <div class="auth-input-wrap">
                    <i class="fas fa-lock"></i>
                    <input asp-for="Password" class="auth-input" type="password"
                           autocomplete="new-password" placeholder="Minimum 8 characters">
                </div>
                <span asp-validation-for="Password"></span>
            </div>

            <div class="auth-field">
                <label asp-for="ConfirmPassword"></label>
                <div class="auth-input-wrap">
                    <i class="fas fa-shield-alt"></i>
                    <input asp-for="ConfirmPassword" class="auth-input" type="password"
                           autocomplete="new-password" placeholder="Repeat password">
                </div>
                <span asp-validation-for="ConfirmPassword"></span>
            </div>
        </div>

        <button type="submit" class="auth-submit">
            Create account <i class="fas fa-arrow-right ml-2"></i>
        </button>
    </form>

    <p class="auth-switch">
        Already have an account?
        <a asp-controller="Login" asp-action="Login">Sign in</a>
    </p>
</div>
