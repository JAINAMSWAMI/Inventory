@model Inventory.Models.LoginModel
@{
    Layout = "_SignUp_Layout";
    ViewData["Title"] = "Sign in";
}

<div class="auth-card">
    <header class="auth-card-header">
        <h2>Welcome back</h2>
        <p>Sign in to continue to your inventory workspace.</p>
    </header>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="auth-alert auth-alert-success">
            <i class="fas fa-check-circle mr-1"></i> @TempData["SuccessMessage"]
        </div>
    }
    @if (!string.IsNullOrWhiteSpace(ViewBag.Message as string))
    {
        <div class="auth-alert auth-alert-danger">
            <i class="fas fa-exclamation-circle mr-1"></i> @ViewBag.Message
        </div>
    }

    <form asp-action="Login" method="post">
        @Html.AntiForgeryToken()
        <div asp-validation-summary="ModelOnly"></div>

        <div class="auth-field">
            <label asp-for="Email"></label>
            <div class="auth-input-wrap">
                <i class="fas fa-envelope"></i>
                <input asp-for="Email" class="auth-input" type="email"
                       autocomplete="email" placeholder="name@company.com" autofocus>
            </div>
            <span asp-validation-for="Email"></span>
        </div>

        <div class="auth-field">
            <label asp-for="Password"></label>
            <div class="auth-input-wrap">
                <i class="fas fa-lock"></i>
                <input asp-for="Password" class="auth-input" type="password"
                       autocomplete="current-password" placeholder="Enter your password">
            </div>
            <span asp-validation-for="Password"></span>
        </div>

        <label class="auth-check">
            <input asp-for="RememberMe" type="checkbox">
            Keep me signed in
        </label>

        <button type="submit" class="auth-submit">
            Sign in <i class="fas fa-arrow-right ml-2"></i>
        </button>
    </form>

    <p class="auth-switch">
        New to Fluxx?
        <a asp-controller="SignUp" asp-action="SignUp">Create an account</a>
    </p>
</div>
