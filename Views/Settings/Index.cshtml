@{
    Layout = "_Layout";
    ViewData["Title"] = "Settings";
    ViewData["SettingsSection"] = "hub";
}

@await Html.PartialAsync("_SettingsSubnav")

<div class="page-hero fx-settings-hero">
    <div>
        <h1>Settings</h1>
        <p>Company, users, module rights, number formats, and lookup masters.</p>
    </div>
</div>

<div class="fx-settings-hub">
    <div class="fx-settings-col">
        <div class="fx-settings-panel">
            <div class="fx-settings-panel-title">Company Settings</div>
            <a class="fx-settings-item" asp-action="Companies">
                <span class="fx-settings-item-icon"><i class="fas fa-building"></i></span>
                <span>
                    <strong>Companies</strong>
                    <small>Billing companies for orders and challans.</small>
                </span>
            </a>
            <a class="fx-settings-item" asp-action="Prefixes">
                <span class="fx-settings-item-icon"><i class="fas fa-hashtag"></i></span>
                <span>
                    <strong>Number Formats</strong>
                    <small>Prefix and starting number for each form.</small>
                </span>
            </a>
            <a class="fx-settings-item" asp-action="Users">
                <span class="fx-settings-item-icon"><i class="fas fa-users"></i></span>
                <span>
                    <strong>User Setup</strong>
                    <small>Create users and assign roles.</small>
                </span>
            </a>
            <a class="fx-settings-item" asp-action="Roles">
                <span class="fx-settings-item-icon"><i class="fas fa-user-tag"></i></span>
                <span>
                    <strong>Role Setup</strong>
                    <small>Create custom roles for access control.</small>
                </span>
            </a>
            <a class="fx-settings-item" asp-action="Rights">
                <span class="fx-settings-item-icon"><i class="fas fa-key"></i></span>
                <span>
                    <strong>Module Rights</strong>
                    <small>Choose which modules each role can open.</small>
                </span>
            </a>
            <a class="fx-settings-item" asp-controller="ApprovalWorkflow" asp-action="Index">
                <span class="fx-settings-item-icon"><i class="fas fa-clipboard-check"></i></span>
                <span>
                    <strong>Approval Workflow</strong>
                    <small>Who must approve Payment, Expense, and other forms.</small>
                </span>
            </a>
            <a class="fx-settings-item" asp-action="Automation">
                <span class="fx-settings-item-icon"><i class="fas fa-robot"></i></span>
                <span>
                    <strong>Automation</strong>
                    <small>Workflows, stock alerts, numbering, and access rules.</small>
                </span>
            </a>
        </div>
    </div>

    <div class="fx-settings-col">
        <div class="fx-settings-panel">
            <div class="fx-settings-panel-title">Data Settings</div>
            <a class="fx-settings-item" asp-action="Lookups" asp-route-tab="values">
                <span class="fx-settings-item-icon"><i class="fas fa-list"></i></span>
                <span>
                    <strong>Lookups</strong>
                    <small>Dropdown values used on forms.</small>
                </span>
            </a>
            <a class="fx-settings-item" asp-action="Lookups" asp-route-tab="location">
                <span class="fx-settings-item-icon"><i class="fas fa-map-marker-alt"></i></span>
                <span>
                    <strong>Locations</strong>
                    <small>State and city master data.</small>
                </span>
            </a>
        </div>
    </div>

    <div class="fx-settings-col">
        <div class="fx-settings-panel">
            <div class="fx-settings-panel-title">Quick Links</div>
            <a class="fx-settings-item" asp-action="Prefixes">
                <span class="fx-settings-item-icon"><i class="fas fa-file-invoice"></i></span>
                <span>
                    <strong>Order &amp; GRN numbers</strong>
                    <small>Jump to document numbering table.</small>
                </span>
            </a>
            <a class="fx-settings-item" asp-action="Rights">
                <span class="fx-settings-item-icon"><i class="fas fa-shield-alt"></i></span>
                <span>
                    <strong>Menu visibility</strong>
                    <small>Control sidebar modules per role.</small>
                </span>
            </a>
        </div>
    </div>
</div>
