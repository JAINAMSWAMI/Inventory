@model Inventory.Models.SettingsPageModel
@{
    Layout = "_Layout";
    ViewData["Title"] = "Number Formats";
    ViewData["SettingsSection"] = "prefixes";
}

@await Html.PartialAsync("_SettingsSubnav")

<div class="page-hero fx-settings-hero">
    <div>
        <a asp-action="Index" class="fx-settings-back"><i class="fas fa-arrow-left"></i> All settings</a>
        <h1>Number Formats</h1>
        <p>Prefix and starting number for each form. Use <code>{FY1-FY2}</code> for fiscal year (e.g. 25-26).</p>
    </div>
</div>

<div class="card fx-card">
    <div class="card-header d-flex justify-content-between align-items-center">
        <strong>Document numbering</strong>
        <span class="badge badge-fx badge-fx-info">@Model.NumberFormats.Count forms</span>
    </div>
    <div class="card-body p-0">
        @if (!Model.NumberFormats.Any())
        {
            <div class="fx-empty py-5">No number formats found. Deploy <code>CompanyDB_NumberFormats.sql</code>.</div>
        }
        else
        {
            <form asp-action="SavePrefixes" method="post">
                @Html.AntiForgeryToken()
                <div class="table-responsive">
                    <table class="table fx-table fx-number-format-table mb-0">
                        <thead>
                            <tr>
                                <th>Form Name</th>
                                <th>Location Code</th>
                                <th>Business Segment</th>
                                <th>Business Category</th>
                                <th>Business Sub Category</th>
                                <th>Prefix</th>
                                <th>Starting Number</th>
                            </tr>
                        </thead>
                        <tbody>
                        @for (var i = 0; i < Model.NumberFormats.Count; i++)
                        {
                            var row = Model.NumberFormats[i];
                            <tr>
                                <td>
                                    <input type="hidden" name="formats[@i].Format_Id" value="@row.Format_Id" />
                                    <input type="hidden" name="formats[@i].Form_Key" value="@row.Form_Key" />
                                    <span class="font-weight-bold">@row.Form_Name</span>
                                    <div class="small text-muted">Next: @row.Next_Number</div>
                                </td>
                                <td>
                                    <input class="form-control form-control-sm" name="formats[@i].Location_Code" value="@row.Location_Code" />
                                </td>
                                <td>
                                    <input class="form-control form-control-sm" name="formats[@i].Business_Segment" value="@row.Business_Segment" />
                                </td>
                                <td>
                                    <input class="form-control form-control-sm" name="formats[@i].Business_Category" value="@row.Business_Category" />
                                </td>
                                <td>
                                    <input class="form-control form-control-sm" name="formats[@i].Business_SubCategory" value="@row.Business_SubCategory" />
                                </td>
                                <td style="min-width:180px">
                                    <input class="form-control form-control-sm" name="formats[@i].Prefix" value="@row.Prefix" required />
                                </td>
                                <td style="width:120px">
                                    <input class="form-control form-control-sm" type="number" min="1"
                                           name="formats[@i].Starting_Number" value="@row.Starting_Number" required />
                                </td>
                            </tr>
                        }
                        </tbody>
                    </table>
                </div>
                <div class="p-3 border-top d-flex justify-content-between align-items-center flex-wrap">
                    <span class="small text-muted">Example: <code>FX ORD/{FY1-FY2}/</code> + starting 100 → <code>FX ORD/25-26/100</code></span>
                    <button type="submit" class="btn btn-fx"><i class="fas fa-save mr-1"></i> Save formats</button>
                </div>
            </form>
        }
    </div>
</div>
