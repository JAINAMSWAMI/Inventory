@model Inventory.Models.AutomationHubViewModel
@{
    Layout = "_Layout";
    ViewData["Title"] = "Automation";
    ViewData["SettingsSection"] = "automation";
}

@await Html.PartialAsync("_SettingsSubnav")

<div class="page-hero fx-settings-hero">
    <div>
        <h1>Automation</h1>
        <p>Workflow rules, multi-user approvals, and inventory alerts that run across your ERP.</p>
    </div>
</div>

<div class="row mb-4">
    <div class="col-md-4 mb-3">
        <div class="fx-metric accent">
            <div class="label">Approval workflows</div>
            <div class="value">@Model.ActiveWorkflows</div>
            <div class="hint">Active routing rules</div>
        </div>
    </div>
    <div class="col-md-4 mb-3">
        <div class="fx-metric warn">
            <div class="label">Low stock alerts</div>
            <div class="value">@Model.LowStockAlerts</div>
            <div class="hint">Items below threshold</div>
        </div>
    </div>
    <div class="col-md-4 mb-3">
        <div class="fx-metric">
            <div class="label">ERP users</div>
            <div class="value">@Model.ActiveUsers</div>
            <div class="hint">Accounts with role access</div>
        </div>
    </div>
</div>

<div class="fx-settings-hub">
    <div class="fx-settings-col">
        <div class="fx-settings-panel">
            <div class="fx-settings-panel-title">Workflow Automation</div>
            <a class="fx-settings-item" asp-controller="ApprovalWorkflow" asp-action="Index">
                <span class="fx-settings-item-icon"><i class="fas fa-project-diagram"></i></span>
                <span>
                    <strong>Approval Workflows</strong>
                    <small>Auto-route Payment, Expense, and other vouchers to the right approver by role.</small>
                </span>
            </a>
            <a class="fx-settings-item" asp-controller="Approval" asp-action="Inbox">
                <span class="fx-settings-item-icon"><i class="fas fa-inbox"></i></span>
                <span>
                    <strong>Approval Inbox</strong>
                    <small>Users see only their pending tasks; managers act without opening every voucher.</small>
                </span>
            </a>
            <a class="fx-settings-item" asp-action="Rights">
                <span class="fx-settings-item-icon"><i class="fas fa-user-shield"></i></span>
                <span>
                    <strong>Role-based Access</strong>
                    <small>Each user only sees ERP modules granted to their role — safe multi-user operation.</small>
                </span>
            </a>
        </div>
    </div>

    <div class="fx-settings-col">
        <div class="fx-settings-panel">
            <div class="fx-settings-panel-title">Inventory Automation</div>
            <a class="fx-settings-item" asp-controller="InventoryControl" asp-action="LowStock">
                <span class="fx-settings-item-icon"><i class="fas fa-exclamation-triangle"></i></span>
                <span>
                    <strong>Low Stock Monitor</strong>
                    <small>Command Center and Alerts flag SKUs at or below the reorder threshold automatically.</small>
                </span>
            </a>
            <a class="fx-settings-item" asp-action="Prefixes">
                <span class="fx-settings-item-icon"><i class="fas fa-hashtag"></i></span>
                <span>
                    <strong>Document Numbering</strong>
                    <small>Orders, GRN, DCN, and invoices get the next number from your company formats.</small>
                </span>
            </a>
            <a class="fx-settings-item" asp-controller="InventoryControl" asp-action="BulkUpload">
                <span class="fx-settings-item-icon"><i class="fas fa-file-excel"></i></span>
                <span>
                    <strong>Bulk Item Import</strong>
                    <small>Load item masters from Excel from the Item Master screen (not duplicated in the menu).</small>
                </span>
            </a>
        </div>
    </div>

    <div class="fx-settings-col">
        <div class="fx-settings-panel">
            <div class="fx-settings-panel-title">Multi-user Controls</div>
            <a class="fx-settings-item" asp-action="Users">
                <span class="fx-settings-item-icon"><i class="fas fa-users"></i></span>
                <span>
                    <strong>User Accounts</strong>
                    <small>Create staff, managers, and admins with individual logins.</small>
                </span>
            </a>
            <a class="fx-settings-item" asp-action="Roles">
                <span class="fx-settings-item-icon"><i class="fas fa-user-tag"></i></span>
                <span>
                    <strong>Role Catalog</strong>
                    <small>Define ERP roles (Admin, Manager, Staff, or custom) for your organization.</small>
                </span>
            </a>
            <a class="fx-settings-item" asp-action="Companies">
                <span class="fx-settings-item-icon"><i class="fas fa-building"></i></span>
                <span>
                    <strong>Company Profiles</strong>
                    <small>Billing entities used on invoices, orders, and challans.</small>
                </span>
            </a>
        </div>
    </div>
</div>
