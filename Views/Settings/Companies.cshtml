@model Inventory.Models.SettingsPageModel
@{
    Layout = "_Layout";
    ViewData["Title"] = "Companies";
    ViewData["SettingsSection"] = "companies";
}

@await Html.PartialAsync("_SettingsSubnav")

<div class="page-hero fx-settings-hero">
    <div>
        <a asp-action="Index" class="fx-settings-back"><i class="fas fa-arrow-left"></i> All settings</a>
        <h1>Companies</h1>
        <p>Billing companies shown on Create Order and Delivery Challan.</p>
    </div>
</div>

<div class="row">
    <div class="col-lg-4 mb-4">
        <div class="card fx-card fx-form-card h-100">
            <div class="card-header">
                <span class="fx-form-icon"><i class="fas fa-building"></i></span>
                <div>
                    <strong>Add company</strong>
                    <div class="small text-muted">Appears in Billing Company dropdowns</div>
                </div>
            </div>
            <div class="card-body">
                <form asp-action="CreateCompany" method="post">
                    @Html.AntiForgeryToken()
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-2"></div>
                    <div class="form-group">
                        <label asp-for="NewCompany.CompanyName"></label>
                        <input asp-for="NewCompany.CompanyName" class="form-control" name="CompanyName" required autofocus>
                    </div>
                    <div class="form-group">
                        <label asp-for="NewCompany.Gstin"></label>
                        <input asp-for="NewCompany.Gstin" class="form-control" name="Gstin">
                    </div>
                    <div class="form-row">
                        <div class="form-group col-md-6">
                            <label asp-for="NewCompany.Email"></label>
                            <input asp-for="NewCompany.Email" class="form-control" name="Email" type="email">
                        </div>
                        <div class="form-group col-md-6">
                            <label asp-for="NewCompany.Phone"></label>
                            <input asp-for="NewCompany.Phone" class="form-control" name="Phone">
                        </div>
                    </div>
                    <div class="form-group">
                        <label asp-for="NewCompany.AddressLine"></label>
                        <input asp-for="NewCompany.AddressLine" class="form-control" name="AddressLine">
                    </div>
                    <button type="submit" class="btn btn-fx btn-block"><i class="fas fa-plus mr-1"></i> Add company</button>
                </form>
            </div>
        </div>
    </div>
    <div class="col-lg-8 mb-4">
        <div class="card fx-card">
            <div class="card-header d-flex justify-content-between align-items-center">
                <strong>Billing companies</strong>
                <span class="badge badge-fx badge-fx-info">@Model.Companies.Count(c => c.IsActive) active</span>
            </div>
            <div class="card-body p-0">
                @if (!Model.Companies.Any())
                {
                    <div class="fx-empty py-5">No companies yet.</div>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table fx-table mb-0">
                            <thead>
                                <tr>
                                    <th>Company</th>
                                    <th>GSTIN</th>
                                    <th>Contact</th>
                                    <th>Status</th>
                                    <th></th>
                                </tr>
                            </thead>
                            <tbody>
                            @foreach (var c in Model.Companies)
                            {
                                <tr class="@(c.IsActive ? "" : "text-muted")">
                                    <td>
                                        <div class="font-weight-bold">@c.CompanyName</div>
                                        @if (!string.IsNullOrWhiteSpace(c.AddressLine))
                                        {
                                            <div class="small text-muted">@c.AddressLine</div>
                                        }
                                    </td>
                                    <td>@(c.Gstin ?? "—")</td>
                                    <td class="small">
                                        @if (!string.IsNullOrWhiteSpace(c.Email)) { <div>@c.Email</div> }
                                        @if (!string.IsNullOrWhiteSpace(c.Phone)) { <div>@c.Phone</div> }
                                        @if (string.IsNullOrWhiteSpace(c.Email) && string.IsNullOrWhiteSpace(c.Phone)) { <span>—</span> }
                                    </td>
                                    <td>
                                        @if (c.IsActive)
                                        {
                                            <span class="badge badge-fx badge-fx-info">Active</span>
                                        }
                                        else
                                        {
                                            <span class="badge badge-secondary">Inactive</span>
                                        }
                                    </td>
                                    <td class="text-right">
                                        @if (c.IsActive)
                                        {
                                            <form asp-action="DeactivateCompany" method="post" class="d-inline">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="id" value="@c.CompanyId" />
                                                <button type="submit" class="btn btn-fx-icon danger" title="Deactivate"
                                                        onclick="return confirm('Remove this company from billing dropdowns?');">
                                                    <i class="fas fa-trash-alt"></i>
                                                </button>
                                            </form>
                                        }
                                    </td>
                                </tr>
                            }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>
    </div>
</div>
