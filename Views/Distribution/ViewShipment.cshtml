@model Inventory.Models.GetShipmentDetailsModel
@{
    Layout = "_Layout";
    ViewData["Title"] = "Shipments";
    var openCount = Model.Items.Count(x => !string.Equals(x.Shipmnt_Status, "Delivered", StringComparison.OrdinalIgnoreCase));
}

<div class="page-hero">
    <div>
        <h1>Shipments</h1>
        <p>Full order lifecycle with customer, product and destination details.</p>
    </div>
    <div class="d-flex" style="gap:.5rem;">
        <a class="btn btn-fx" asp-action="CreateOrder"><i class="fas fa-plus mr-2"></i>Create order</a>
        <a class="btn btn-fx-outline" asp-action="Tracking"><i class="fas fa-search-location mr-2"></i>Track</a>
    </div>
</div>

<div class="fx-stats-row">
    <div class="fx-stat-card">
        <span class="fx-stat-icon"><i class="fas fa-truck"></i></span>
        <div><span class="fx-stat-value">@Model.Items.Count</span><span class="fx-stat-label">Total orders</span></div>
    </div>
    <div class="fx-stat-card">
        <span class="fx-stat-icon warning"><i class="fas fa-clock"></i></span>
        <div><span class="fx-stat-value">@openCount</span><span class="fx-stat-label">In progress</span></div>
    </div>
    <div class="fx-stat-card">
        <span class="fx-stat-icon info"><i class="fas fa-rupee-sign"></i></span>
        <div><span class="fx-stat-value">@Model.Items.Sum(x => x.Order_Total_Cost).ToString("N0")</span><span class="fx-stat-label">Order value</span></div>
    </div>
</div>

<div class="card fx-card">
    <div class="fx-toolbar">
        <div class="fx-search">
            <i class="fas fa-search"></i>
            <input id="shipSearch" class="form-control" type="search" placeholder="Search order, customer, tracking, city...">
        </div>
        <select id="shipStatus" class="form-control fx-filter">
            <option value="">All statuses</option>
            <option value="processing">Processing</option>
            <option value="shipped">Shipped</option>
            <option value="out for delivery">Out for Delivery</option>
            <option value="delivered">Delivered</option>
        </select>
        <span class="fx-result-count"><strong id="shipCount">@Model.Items.Count</strong> shipments</span>
    </div>

    <div class="card-body p-0">
        @if (!Model.Items.Any())
        {
            <div class="fx-empty">
                <i class="fas fa-truck d-block"></i>
                <h5>No shipments yet</h5>
                <p>Create an order to start the outbound lifecycle.</p>
                <a class="btn btn-fx" asp-action="CreateOrder">Create order</a>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table fx-table mb-0">
                    <thead>
                        <tr>
                            <th>Order / Customer</th>
                            <th>Product</th>
                            <th>Destination</th>
                            <th>Warehouse / Carrier</th>
                            <th>Dates</th>
                            <th>Total</th>
                            <th>Status</th>
                            <th class="text-right">Actions</th>
                        </tr>
                    </thead>
                    <tbody id="shipRows">
                    @foreach (var item in Model.Items)
                    {
                        var status = (item.Shipmnt_Status ?? "").ToLowerInvariant();
                        var badge = status switch
                        {
                            "delivered" => "badge-fx-success",
                            "shipped" or "out for delivery" => "badge-fx-info",
                            "processing" => "badge-fx-warning",
                            _ => "badge-fx-muted"
                        };
                        <tr data-search="@($"{item.Order_No} {item.Customer_Name} {item.Shipmnt_Tracking_No} {item.City_Name} {item.Product_Name}".ToLowerInvariant())"
                            data-status="@status">
                            <td>
                                <div class="fx-entity-title">@item.Order_No</div>
                                <div class="fx-entity-subtitle">@(item.Customer_Name ?? "—") · @(item.Customer_Phone ?? "")</div>
                                <div class="small text-muted font-monospace">@item.Shipmnt_Tracking_No</div>
                            </td>
                            <td>
                                <div>@(item.Product_Name ?? "—")</div>
                                <div class="small text-muted">Qty: @item.Quantity</div>
                            </td>
                            <td>
                                <div>@(item.City_Name ?? "—")@(string.IsNullOrEmpty(item.State_Name) ? "" : $", {item.State_Name}")</div>
                                <div class="small text-muted text-truncate" style="max-width:180px;">@(item.Shipping_Address ?? "")</div>
                            </td>
                            <td>
                                <div>@item.Warehouse_Name</div>
                                <div class="small text-muted">@item.Shipping_Company</div>
                            </td>
                            <td>
                                <div class="small">Ordered @item.Order_Date.ToString("dd MMM yyyy")</div>
                                <div class="small text-muted">ETA @item.Delivery_Expected_Date.ToString("dd MMM yyyy")</div>
                            </td>
                            <td>₹@item.Order_Total_Cost.ToString("N0")</td>
                            <td>
                                <span class="badge badge-fx @badge">@item.Shipmnt_Status</span>
                                @if (!string.IsNullOrEmpty(item.Order_Priority) && item.Order_Priority != "Normal")
                                {
                                    <div class="small mt-1"><span class="badge badge-fx badge-fx-danger">@item.Order_Priority</span></div>
                                }
                            </td>
                            <td class="text-right">
                                <a class="btn btn-sm btn-fx" asp-action="Tracking" asp-route-trackingNo="@item.Shipmnt_Tracking_No">
                                    <i class="fas fa-map-marker-alt mr-1"></i>Track
                                </a>
                            </td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
            <div id="shipEmpty" class="fx-empty fx-filter-empty"><i class="fas fa-search d-block"></i>No shipments match your filters.</div>
        }
    </div>
</div>

@section Scripts {
<script>
(function () {
    const search = document.getElementById('shipSearch');
    const status = document.getElementById('shipStatus');
    const rows = [...document.querySelectorAll('#shipRows tr')];
    const count = document.getElementById('shipCount');
    const empty = document.getElementById('shipEmpty');
    function filterRows() {
        const q = search.value.trim().toLowerCase();
        let visible = 0;
        rows.forEach(row => {
            const show = row.dataset.search.includes(q) && (!status.value || row.dataset.status === status.value);
            row.style.display = show ? '' : 'none';
            if (show) visible++;
        });
        count.textContent = visible;
        if (empty) empty.style.display = visible ? 'none' : 'block';
    }
    search.addEventListener('input', filterRows);
    status.addEventListener('change', filterRows);
})();
</script>
}
