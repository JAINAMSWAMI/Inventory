@model GetShipmentDetailsModel
@{
    Layout = "_Layout";
    ViewData["Title"] = "Get Shipment Details";
}

<div class="container-fluid py-4">
    <div class="card shadow-lg border-0 rounded-lg">
        <div class="card-header bg-primary p-4">
            <div class="d-flex justify-content-between align-items-center">
                <h3 class="text-white m-0 font-weight-bold">Shipment Details</h3>
                <div class="d-flex gap-2">
                    <button class="btn btn-light" onclick="exportToExcel()">
                        <i class="fas fa-file-excel me-2"></i>Export
                    </button>
                    <button class="btn btn-light" onclick="window.print()">
                        <i class="fas fa-print me-2"></i>Print
                    </button>
                </div>
            </div>
        </div>
        <div class="card-body p-4">
            <div class="table-responsive">
                <table id="datatablesSimple" class="table table-hover border-secondary align-middle">
                    <thead>
                        <tr class="bg-light">
                            <th class="py-3">Order No.</th>
                            <th class="py-3">Ordered Date<br><small class="text-muted">(dd-mm-yy)</small></th>
                            <th class="py-3">Expected Delivery<br><small class="text-muted">(dd-mm-yy)</small></th>
                            <th class="py-3">Order Cost</th>
                            <th class="py-3">Warehouse Name</th>
                            <th class="py-3">Shipping Company</th>
                            <th class="py-3">Tracking No.</th>
                            <th class="py-3 text-center">Status</th>
                            <th class="py-3 text-center">Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model.Items)
                        {
                            <tr class="border-bottom">
                                <td class="py-3">@item.Order_No</td>
                                <td class="py-3">@item.Order_Date</td>
                                <td class="py-3">@item.Delivery_Expected_Date</td>
                                <td class="py-3">@item.Order_Total_Cost</td>
                                <td class="py-3">@item.Warehouse_Name</td>
                                <td class="py-3">@item.Shipping_Company</td>
                                <td class="py-3 font-monospace">@item.Shipmnt_Tracking_No</td>
                                <td class="py-3 text-center">
                                    @{
                                        var statusClass = item.Shipmnt_Status.ToLower() switch
                                        {
                                            "delivered" => "status-delivered",
                                            "in transit" => "status-transit",
                                            "pending" => "status-pending",
                                            _ => "status-other"
                                        };
                                    }
                                    <span class="status-badge @statusClass">@item.Shipmnt_Status</span>
                                </td>
                                <td class="py-3 text-center">
                                    <a href="@Url.Action("Tracking", "Distribution", new { id = item.Order_No })" 
                                       class="btn btn-primary btn-sm rounded-pill px-3 shadow-sm">
                                        <i class="fas fa-map-marker-alt me-2"></i>Track
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<style>
    .table th {
        font-weight: 600;
        color: #495057;
    }

    .table td {
        color: #555;
    }

    /* Status badge styles - smaller and more subtle */
    .status-badge {
        display: inline-block;
        font-size: 10px;
        padding: 2px 6px;
        border-radius: 3px;
        font-weight: 400;
        letter-spacing: 0.2px;
        text-transform: uppercase;
        color: #000000 !important;
        -webkit-text-fill-color: #000000;
    }
    
    .status-delivered {
        background-color: rgba(25, 135, 84, 0.15);
        color: #155724;
        border: 1px solid rgba(25, 135, 84, 0.2);
    }
    
    .status-transit {
        background-color: rgba(13, 110, 253, 0.15);
        color: #0d6efd;
        border: 1px solid rgba(13, 110, 253, 0.2);
    }
    
    .status-pending {
        background-color: rgba(255, 193, 7, 0.15);
        color: #856404;
        border: 1px solid rgba(255, 193, 7, 0.2);
    }
    
    .status-other {
        background-color: rgba(108, 117, 125, 0.15);
        color: #6c757d;
        border: 1px solid rgba(108, 117, 125, 0.2);
    }

    .btn-sm {
        transition: all 0.3s;
    }

    .btn-sm:hover {
        transform: translateY(-2px);
    }

    .table-hover tbody tr:hover {
        background-color: rgba(13, 110, 253, 0.04);
    }

    /* Make the table display fully without horizontal scrolling */
    .table {
        width: 100%;
        table-layout: fixed;
    }
    
    /* Distribute column widths appropriately */
    .table th:nth-child(1), 
    .table td:nth-child(1) {
        width: 10%;
    }
    
    .table th:nth-child(2), 
    .table td:nth-child(2),
    .table th:nth-child(3), 
    .table td:nth-child(3) {
        width: 12%;
    }
    
    .table th:nth-child(4), 
    .table td:nth-child(4) {
        width: 10%;
    }
    
    .table th:nth-child(5), 
    .table td:nth-child(5),
    .table th:nth-child(6), 
    .table td:nth-child(6) {
        width: 13%;
    }
    
    .table th:nth-child(7), 
    .table td:nth-child(7) {
        width: 12%;
    }
    
    .table th:nth-child(8), 
    .table td:nth-child(8),
    .table th:nth-child(9), 
    .table td:nth-child(9) {
        width: 9%;
    }
    
    /* Enable text wrapping for longer content */
    .table th, 
    .table td {
        word-wrap: break-word;
        overflow-wrap: break-word;
    }

    /* Custom scrollbar for table when needed on smaller screens */
    media (max-width: 992px) {
        .table-responsive {
            overflow-x: auto;
        }
        
        .table-responsive::-webkit-scrollbar {
            height: 8px;
        }

        .table-responsive::-webkit-scrollbar-track {
            background: #f1f1f1;
            border-radius: 4px;
        }

        .table-responsive::-webkit-scrollbar-thumb {
            background: #888;
            border-radius: 4px;
        }

        .table-responsive::-webkit-scrollbar-thumb:hover {
            background: #555;
        }
    }

    /* Print styles */
    media print {
        .btn-sm {
            display: none;
        }
        .card {
            box-shadow: none !important;
        }
    }
</style>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        function exportToExcel() {
            // Add your Excel export logic here
            alert('Export to Excel functionality can be implemented here');
        }
    </script>
}