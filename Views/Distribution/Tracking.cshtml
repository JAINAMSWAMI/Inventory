@{
    Layout = "_Layout";
    ViewData["Title"] = "Track Shipment";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-lg-8 col-md-10">
            <div class="card shadow-lg border-0 rounded-lg">
                <div class="card-header bg-primary text-white text-center py-4">
                    <h3 class="mb-0 font-weight-bold">Track Your Shipment</h3>
                </div>

                <div class="card-body p-5">
                    <div class="input-container text-center">
                        <div class="mb-4">
                            <div class="form-floating">
                                <input type="text" id="trackingNo" class="form-control form-control-lg" placeholder="Enter Tracking Number">
                                <label for="trackingNo">Enter Tracking Number</label>
                            </div>
                            <button type="button" class="btn btn-primary btn-lg px-5 mt-4 shadow-sm" onclick="updateTrackingProgress()">
                                <i class="fas fa-search me-2"></i>Track Order
                            </button>
                        </div>
                    </div>

                    <div class="tracking-container mt-5" id="trackingContainer" style="display: none; opacity: 0; transition: opacity 0.5s;">
                        <h4 class="text-primary mb-4 text-center">Shipment Status</h4>
                        <div class="progress-container position-relative px-4">
                            <div class="progress-line"></div>
                            <div class="progress-line-fill" id="progress-line-fill"></div>
                            <div class="steps-container d-flex justify-content-between position-relative">
                                <div class="step">
                                    <div class="circle" id="step1">
                                        <i class="fas fa-spinner"></i>
                                    </div>
                                    <div class="label" id="label1">Processing</div>
                                </div>
                                <div class="step">
                                    <div class="circle" id="step2">
                                        <i class="fas fa-shipping-fast"></i>
                                    </div>
                                    <div class="label" id="label2">Shipped</div>
                                </div>
                                <div class="step">
                                    <div class="circle" id="step3">
                                        <i class="fas fa-truck"></i>
                                    </div>
                                    <div class="label" id="label3">Out for Delivery</div>
                                </div>
                                <div class="step">
                                    <div class="circle" id="step4">
                                        <i class="fas fa-check"></i>
                                    </div>
                                    <div class="label" id="label4">Delivered</div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .card {
        transition: transform 0.2s;
    }
    
    .card:hover {
        transform: translateY(-5px);
    }
    
    .progress-container {
        margin: 40px 0;
    }
    
    .progress-line {
        position: absolute;
        top: 25px;
        left: 50px;
        right: 50px;
        height: 4px;
        background: #e9ecef;
        z-index: 1;
    }
    
    .progress-line-fill {
        position: absolute;
        top: 25px;
        left: 50px;
        height: 4px;
        background: #0d6efd;
        transition: width 1.5s cubic-bezier(0.4, 0, 0.2, 1);
        z-index: 2;
    }
    
    .steps-container {
        z-index: 3;
    }
    
    .step {
        display: flex;
        flex-direction: column;
        align-items: center;
        flex: 1;
    }
    
    .circle {
        width: 50px;
        height: 50px;
        border-radius: 50%;
        background: #fff;
        border: 3px solid #e9ecef;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.2rem;
        color: #6c757d;
        transition: all 0.5s ease;
        margin-bottom: 8px;
    }
    
    .circle.active {
        background: #0d6efd;
        border-color: #0d6efd;
        color: white;
        box-shadow: 0 0 0 3px rgba(13, 110, 253, 0.2);
    }
    
    .label {
        font-size: 0.875rem;
        font-weight: 500;
        color: #6c757d;
        text-align: center;
        transition: color 0.5s ease;
        margin-top: 8px;
    }
    
    .label.active {
        color: #0d6efd;
        font-weight: 600;
    }
    
    .btn-primary {
        transition: all 0.3s;
    }
    
    .btn-primary:hover {
        transform: translateY(-2px);
        box-shadow: 0 4px 12px rgba(13, 110, 253, 0.3) !important;
    }
    
    .form-control:focus {
        border-color: #0d6efd;
        box-shadow: 0 0 0 0.25rem rgba(13, 110, 253, 0.25);
    }
    
    media (max-width: 768px) {
        .label {
            font-size: 0.75rem;
        }
        
        .circle {
            width: 40px;
            height: 40px;
            font-size: 1rem;
        }
        
        .progress-line, .progress-line-fill {
            left: 30px;
            right: 30px;
        }

    .bg-gradient-primary {
        background: linear-gradient(45deg, #2937f0, #9f1ae2);
    }

    .table th {
        font-weight: 600;
        color: #495057;
        white-space: nowrap;
    }

    .table td {
        color: #555;
    }

    .badge {
        font-weight: 500;
        letter-spacing: 0.3px;
    }

    .btn-sm {
        transition: all 0.2s ease-in-out;
    }

        .btn-sm:hover {
            transform: translateY(-2px);
            box-shadow: 0 5px 15px rgba(0,0,0,0.1) !important;
        }

    .table-hover tbody tr {
        transition: all 0.2s ease-in-out;
    }

        .table-hover tbody tr:hover {
            background-color: rgba(13, 110, 253, 0.04);
            transform: scale(1.001);
        }

    /* Improved scrollbar styling */
    .table-responsive {
        overflow-x: auto;
        scrollbar-width: thin;
        scrollbar-color: #888 #f1f1f1;
    }

        .table-responsive::-webkit-scrollbar {
            height: 8px;
        }

        .table-responsive::-webkit-scrollbar-track {
            background: #f1f1f1;
            border-radius: 4px;
        }

        .table-responsive::-webkit-scrollbar-thumb {
            background: #888;
            border-radius: 4px;
        }

            .table-responsive::-webkit-scrollbar-thumb:hover {
                background: #555;
            }

    /* Print styles */
    media print {
        .btn, .bg-gradient-primary

    {
        background: none !important;
    }

    .text-white {
        color: #000 !important;
    }

    .card {
        box-shadow: none !important;
    }

    .badge {
        border: 1px solid #dee2e6;
    }

    }
    }
</style>

<script>
    async function fetchOrderProgress(trackingNo) {
        try {
            const response = await fetch(`/Distribution/GetOrderProgress?trackingNo=${trackingNo}`);
            if (!response.ok) throw new Error("Failed to fetch order progress.");
            const data = await response.json();
            return data.currentStep;
        } catch (error) {
            console.error("Error fetching order progress:", error);
            return 1;
        }
    }

    async function updateTrackingProgress() {
        const trackingNo = document.getElementById("trackingNo").value;
        if (!trackingNo) {
            Swal.fire({
                title: 'Error!',
                text: 'Please enter a tracking number',
                icon: 'error',
                confirmButtonText: 'OK'
            });
            return;
        }
        
        const currentStep = await fetchOrderProgress(trackingNo);
        updateProgress(currentStep);
        const trackingContainer = document.getElementById("trackingContainer");
        trackingContainer.style.display = "block";
        setTimeout(() => trackingContainer.style.opacity = 1, 50);
    }

    function updateProgress(currentStep) {
        const progressLineFill = document.getElementById('progress-line-fill');
        const circles = document.querySelectorAll('.circle');
        const labels = document.querySelectorAll('.label');
        const progressPercentage = ((currentStep - 1) / (circles.length - 1)) * 100;
        progressLineFill.style.width = `${progressPercentage}%`;
        
        circles.forEach((circle, index) => {
            circle.classList.toggle('active', index < currentStep);
            labels[index].classList.toggle('active', index < currentStep);
        });
    }
</script>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
}