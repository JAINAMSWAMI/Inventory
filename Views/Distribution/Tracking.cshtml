@{
    Layout = "_Layout";
    ViewData["Title"] = "Track Shipment";
    var prefill = ViewBag.TrackingNo as string;
}

<div class="fx-track-page">
    <div class="page-hero page-hero-center text-center">
        <div>
            <h1>Track shipment</h1>
            <p>Enter a tracking number to animate live delivery progress.</p>
        </div>
    </div>

    <div class="fx-track-shell">
        <div class="card fx-card fx-track-card">
            <div class="fx-track-hero">
                <div class="fx-track-pulse" aria-hidden="true"></div>
                <span class="fx-track-badge"><i class="fas fa-map-marker-alt"></i> Live tracking</span>
                <h2>Where is my order?</h2>
                <p>Paste your TRK number — watch the journey light up step by step.</p>

                <form id="trackForm" class="fx-track-form" autocomplete="off" onsubmit="return false;">
                    <div class="fx-track-input-wrap">
                        <i class="fas fa-barcode"></i>
                        <input type="text" id="trackingNo" class="form-control"
                               placeholder="e.g. TRK-A1B2C3D4E5F6"
                               value="@prefill"
                               maxlength="40"
                               aria-label="Tracking number" />
                        <button type="button" id="trackBtn" class="btn btn-fx" onclick="runTracking()">
                            <i class="fas fa-search mr-1"></i> Track
                        </button>
                    </div>
                </form>
            </div>

            <div class="fx-track-result" id="trackingContainer" hidden>
                <div class="fx-track-meta" id="trackMeta">
                    <div>
                        <span class="label">Tracking</span>
                        <strong id="metaTracking" class="font-monospace">—</strong>
                    </div>
                    <div>
                        <span class="label">Order</span>
                        <strong id="metaOrder">—</strong>
                    </div>
                    <div>
                        <span class="label">Status</span>
                        <strong id="metaStatus" class="fx-track-status">—</strong>
                    </div>
                </div>

                <div class="fx-track-progress" id="progressRoot">
                    <div class="fx-track-rail">
                        <div class="fx-track-rail-fill" id="progressFill"></div>
                        <div class="fx-track-courier" id="courierIcon"><i class="fas fa-truck"></i></div>
                    </div>

                    <div class="fx-track-steps">
                        <div class="fx-track-step" data-step="1">
                            <div class="fx-track-dot"><i class="fas fa-box-open"></i></div>
                            <div class="fx-track-step-label">Processing</div>
                            <div class="fx-track-step-hint">Order confirmed</div>
                        </div>
                        <div class="fx-track-step" data-step="2">
                            <div class="fx-track-dot"><i class="fas fa-warehouse"></i></div>
                            <div class="fx-track-step-label">Shipped</div>
                            <div class="fx-track-step-hint">Left warehouse</div>
                        </div>
                        <div class="fx-track-step" data-step="3">
                            <div class="fx-track-dot"><i class="fas fa-shipping-fast"></i></div>
                            <div class="fx-track-step-label">Out for delivery</div>
                            <div class="fx-track-step-hint">On the road</div>
                        </div>
                        <div class="fx-track-step" data-step="4">
                            <div class="fx-track-dot"><i class="fas fa-check"></i></div>
                            <div class="fx-track-step-label">Delivered</div>
                            <div class="fx-track-step-hint">Complete</div>
                        </div>
                    </div>
                </div>

                <div class="fx-track-details" id="trackDetails" hidden>
                    <div class="fx-track-detail-item">
                        <span>Customer</span>
                        <strong id="metaCustomer">—</strong>
                    </div>
                    <div class="fx-track-detail-item">
                        <span>Product</span>
                        <strong id="metaProduct">—</strong>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Styles {
<style>
.page-hero-center { justify-content: center; width: 100%; }
.fx-track-page { max-width: 920px; margin: 0 auto; }
.fx-track-shell { margin: 0 auto; }
.fx-track-card { overflow: hidden; }

.fx-track-hero {
    position: relative;
    padding: 2.25rem 1.75rem 1.75rem;
    text-align: center;
    background:
        radial-gradient(ellipse 80% 60% at 50% -10%, rgba(13, 148, 136, .22), transparent 55%),
        linear-gradient(165deg, #0f1c2e 0%, #16324f 50%, #0d4f4a 100%);
    color: #fff;
    overflow: hidden;
}
.fx-track-hero h2 {
    font-family: "Syne", sans-serif;
    font-weight: 800;
    font-size: 1.75rem;
    margin: .65rem 0 .35rem;
}
.fx-track-hero > p { color: rgba(255,255,255,.72); margin-bottom: 1.35rem; }
.fx-track-badge {
    display: inline-flex;
    align-items: center;
    gap: .4rem;
    padding: .35rem .75rem;
    border-radius: 999px;
    background: rgba(94, 234, 212, .18);
    color: #99f6e4;
    font-size: .75rem;
    font-weight: 700;
    letter-spacing: .06em;
    text-transform: uppercase;
}
.fx-track-pulse {
    position: absolute;
    width: 180px; height: 180px;
    border-radius: 50%;
    right: -40px; top: -50px;
    background: rgba(94, 234, 212, .12);
    animation: fxPulse 3.2s ease-in-out infinite;
}
@@keyframes fxPulse {
    0%, 100% { transform: scale(1); opacity: .7; }
    50% { transform: scale(1.15); opacity: 1; }
}

.fx-track-form { max-width: 560px; margin: 0 auto; }
.fx-track-input-wrap {
    display: flex;
    align-items: center;
    gap: .5rem;
    padding: .45rem .45rem .45rem 1rem;
    background: #fff;
    border-radius: 14px;
    box-shadow: 0 12px 40px rgba(0,0,0,.25);
}
.fx-track-input-wrap > i { color: #94a3b8; }
.fx-track-input-wrap .form-control {
    border: 0;
    box-shadow: none !important;
    min-height: 44px;
    font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
    font-weight: 600;
    letter-spacing: .04em;
}
.fx-track-input-wrap .btn { white-space: nowrap; border-radius: 10px; }

.fx-track-result {
    padding: 1.75rem 1.5rem 2rem;
    animation: fxReveal .55s ease both;
}
.fx-track-result.is-animating {
    animation: fxReveal .55s ease both;
}
@@keyframes fxReveal {
    from { opacity: 0; transform: translateY(16px); }
    to { opacity: 1; transform: translateY(0); }
}

.fx-track-meta {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1rem;
    margin-bottom: 2rem;
    padding: 1rem 1.15rem;
    background: #f0fdfa;
    border: 1px solid #ccfbf1;
    border-radius: 12px;
}
.fx-track-meta .label {
    display: block;
    font-size: .7rem;
    font-weight: 700;
    letter-spacing: .06em;
    text-transform: uppercase;
    color: #64748b;
    margin-bottom: .2rem;
}
.fx-track-status { color: var(--fx-accent-deep); }

.fx-track-progress { position: relative; padding: 1.25rem .5rem 0; }
.fx-track-rail {
    position: absolute;
    top: 1.9rem;
    left: 8%;
    right: 8%;
    height: 6px;
    background: #e2e8f0;
    border-radius: 999px;
    z-index: 1;
}
.fx-track-rail-fill {
    height: 100%;
    width: 0;
    border-radius: 999px;
    background: linear-gradient(90deg, #0d9488, #14b8a6);
    transition: width 1.4s cubic-bezier(.22, 1, .36, 1);
    box-shadow: 0 0 16px rgba(13, 148, 136, .45);
}
.fx-track-courier {
    position: absolute;
    top: 50%;
    left: 0;
    width: 36px;
    height: 36px;
    margin-top: -18px;
    margin-left: -18px;
    border-radius: 50%;
    background: #0f766e;
    color: #fff;
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 6px 18px rgba(15, 118, 110, .4);
    transition: left 1.4s cubic-bezier(.22, 1, .36, 1);
    z-index: 3;
}
.fx-track-courier.bounce { animation: fxTruckBounce .6s ease; }
@@keyframes fxTruckBounce {
    0%, 100% { transform: translateY(0); }
    40% { transform: translateY(-8px); }
    70% { transform: translateY(-2px); }
}

.fx-track-steps {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: .5rem;
    position: relative;
    z-index: 2;
}
.fx-track-step {
    text-align: center;
    opacity: .45;
    transform: translateY(6px);
    transition: opacity .4s, transform .4s;
}
.fx-track-step.active,
.fx-track-step.done {
    opacity: 1;
    transform: translateY(0);
}
.fx-track-dot {
    width: 48px;
    height: 48px;
    margin: 0 auto .65rem;
    border-radius: 50%;
    border: 3px solid #cbd5e1;
    background: #fff;
    color: #94a3b8;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.05rem;
    transition: all .45s ease;
}
.fx-track-step.done .fx-track-dot {
    background: #0d9488;
    border-color: #0d9488;
    color: #fff;
    box-shadow: 0 0 0 5px rgba(13, 148, 136, .18);
}
.fx-track-step.active .fx-track-dot {
    background: #fff;
    border-color: #0d9488;
    color: #0d9488;
    animation: fxDotPulse 1.2s ease infinite;
}
@@keyframes fxDotPulse {
    0%, 100% { box-shadow: 0 0 0 0 rgba(13, 148, 136, .35); }
    50% { box-shadow: 0 0 0 10px rgba(13, 148, 136, 0); }
}
.fx-track-step-label {
    font-weight: 700;
    font-size: .88rem;
    color: var(--fx-ink);
}
.fx-track-step-hint {
    font-size: .72rem;
    color: #94a3b8;
}

.fx-track-details {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
    margin-top: 1.75rem;
    padding-top: 1.25rem;
    border-top: 1px solid #edf2f7;
}
.fx-track-detail-item span {
    display: block;
    font-size: .72rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: .05em;
    color: #94a3b8;
}
.fx-track-detail-item strong { color: var(--fx-ink); }

.fx-track-input-wrap.scanning {
    animation: fxScanGlow 1s ease;
}
@@keyframes fxScanGlow {
    0%, 100% { box-shadow: 0 12px 40px rgba(0,0,0,.25); }
    50% { box-shadow: 0 0 0 4px rgba(13, 148, 136, .35), 0 12px 40px rgba(0,0,0,.25); }
}

@@media (max-width: 640px) {
    .fx-track-meta { grid-template-columns: 1fr; }
    .fx-track-input-wrap { flex-wrap: wrap; }
    .fx-track-input-wrap .btn { width: 100%; }
    .fx-track-step-label { font-size: .72rem; }
    .fx-track-dot { width: 40px; height: 40px; font-size: .9rem; }
}
</style>
}

@section Scripts {
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
<script>
(function () {
    const input = document.getElementById('trackingNo');
    const container = document.getElementById('trackingContainer');
    const fill = document.getElementById('progressFill');
    const courier = document.getElementById('courierIcon');
    const steps = [...document.querySelectorAll('.fx-track-step')];

    input.addEventListener('keydown', function (e) {
        if (e.key === 'Enter') {
            e.preventDefault();
            runTracking();
        }
    });

    window.runTracking = async function () {
        const trackingNo = (input.value || '').trim();
        if (!trackingNo) {
            Swal.fire({
                icon: 'warning',
                title: 'Tracking number needed',
                text: 'Enter a TRK number to start the journey animation.',
                confirmButtonColor: '#0d9488'
            });
            return;
        }

        const wrap = document.querySelector('.fx-track-input-wrap');
        wrap.classList.add('scanning');
        setTimeout(() => wrap.classList.remove('scanning'), 1000);

        const btn = document.getElementById('trackBtn');
        btn.disabled = true;
        btn.innerHTML = '<i class="fas fa-spinner fa-spin mr-1"></i> Locating…';

        try {
            const res = await fetch('/Distribution/GetOrderProgress?trackingNo=' + encodeURIComponent(trackingNo));
            const data = await res.json();

            if (!data.found) {
                container.hidden = true;
                Swal.fire({
                    icon: 'error',
                    title: 'Not found',
                    text: 'No shipment matches “' + trackingNo + '”. Check the number and try again.',
                    confirmButtonColor: '#0d9488'
                });
                return;
            }

            document.getElementById('metaTracking').textContent = trackingNo;
            document.getElementById('metaOrder').textContent = data.orderNo || '—';
            document.getElementById('metaStatus').textContent = data.status || '—';
            document.getElementById('metaCustomer').textContent = data.customer || '—';
            document.getElementById('metaProduct').textContent = data.product || '—';
            document.getElementById('trackDetails').hidden = !(data.customer || data.product);

            container.hidden = false;
            container.classList.remove('is-animating');
            void container.offsetWidth;
            container.classList.add('is-animating');

            await animateProgress(0);
            await sleep(180);
            await animateProgress(data.currentStep || 1);

            Swal.fire({
                toast: true,
                position: 'top-end',
                icon: 'success',
                title: 'Shipment located',
                text: data.status || 'Status updated',
                showConfirmButton: false,
                timer: 2200,
                timerProgressBar: true
            });
        } catch (err) {
            console.error(err);
            Swal.fire({
                icon: 'error',
                title: 'Tracking failed',
                text: 'Could not reach the tracking service. Try again.',
                confirmButtonColor: '#0d9488'
            });
        } finally {
            btn.disabled = false;
            btn.innerHTML = '<i class="fas fa-search mr-1"></i> Track';
        }
    };

    async function animateProgress(step) {
        const total = steps.length;
        const pct = total <= 1 ? 0 : ((Math.max(step, 1) - 1) / (total - 1)) * 100;
        fill.style.width = pct + '%';
        courier.style.left = pct + '%';
        courier.classList.remove('bounce');
        void courier.offsetWidth;
        courier.classList.add('bounce');

        steps.forEach((el, i) => {
            const n = i + 1;
            el.classList.remove('active', 'done');
            if (n < step) el.classList.add('done');
            else if (n === step) el.classList.add('active', 'done');
        });
    }

    function sleep(ms) { return new Promise(r => setTimeout(r, ms)); }

    @if (!string.IsNullOrWhiteSpace(prefill))
    {
        <text>document.addEventListener('DOMContentLoaded', function () { runTracking(); });</text>
    }
})();
</script>
}
