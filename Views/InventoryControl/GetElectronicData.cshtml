@model Inventory.Models.GetElectronicModel

@{
    Layout = "_Layout";
    ViewData["Title"] = "Electronic Inventory";
}

<div class="container-fluid py-4">
    <div class="card shadow-lg border-0 rounded-lg">
        <div class="card-header bg-primary p-4">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <h3 class="text-white m-0 fw-bold">Electronic Inventory</h3>
                    <p class="text-white-50 mb-0">Manage your electronic products inventory</p>
                </div>
                <div class="d-flex gap-3">
                    <button class="btn btn-light d-flex align-items-center" onclick="exportToExcel()">
                        <i class="fas fa-file-excel me-2"></i>Export to Excel
                    </button>
                    <button class="btn btn-light d-flex align-items-center" onclick="window.print()">
                        <i class="fas fa-print me-2"></i>Print Inventory
                    </button>
                </div>
            </div>
        </div>

        <div class="card-body p-4">
            <div class="table-responsive">
                <table id="inventoryTable" class="table table-hover align-middle">
                    <thead>
                        <tr class="bg-light">
                            <th class="py-3 px-4">Product Details</th>
                            <th class="py-3 px-4">Specifications</th>
                            <th class="py-3 px-4">Stock & Price</th>
                            <th class="py-3 px-4">Warranty</th>
                            <th class="py-3 px-4 text-center">Status</th>
                            <th class="py-3 px-4 text-center">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model.Data)
                        {
                            <tr class="border-bottom">
                                <td class="py-3 px-4">
                                    <div class="d-flex flex-column">
                                        <span class="fw-bold">#@item.Electronic_Id - @item.Electronic_Name</span>
                                        <span class="text-muted small">@item.Electronic_Brand</span>
                                        <span class="badge bg-info text-white small">@item.Electronic_Sub_Category</span>
                                    </div>
                                </td>
                                <td class="py-3 px-4">
                                    <span class="text-wrap">@item.Electronic_Specs</span>
                                </td>
                                <td class="py-3 px-4">
                                    <div class="d-flex flex-column">
                                        <span class="fw-bold">$@item.Electronic_Price</span>
                                        <div class="d-flex align-items-center">
                                            <i class="fas fa-box text-muted me-2"></i>
                                            <span>Stock: @item.Electronic_CRStock</span>
                                        </div>
                                    </div>
                                </td>
                                <td class="py-3 px-4">
                                    <div class="d-flex align-items-center">
                                        <i class="fas fa-shield-alt text-muted me-2"></i>
                                        <span>@item.Electronic_Warrenty_Period</span>
                                    </div>
                                </td>
                                <td class="py-3 px-4 text-center">
                                    @{
                                        var statusClass = item.Electronic_Status.ToLower() switch
                                        {
                                            "active" => "bg-success",
                                            "low stock" => "bg-warning",
                                            "out of stock" => "bg-danger",
                                            _ => "bg-secondary"
                                        };
                                    }
                                    <span class="badge @statusClass rounded-pill px-3 py-2">
                                        @item.Electronic_Status
                                    </span>
                                </td>
                                <td class="py-3 px-4 text-center">
                                    <div class="d-flex gap-2 justify-content-center">
                                        <a href="@Url.Action("EditElectronic", "InventoryControl", new { id = item.Electronic_Id })" 
                                           class="btn btn-primary btn-sm rounded-pill px-3">
                                            <i class="fas fa-edit me-1"></i> Edit
                                        </a>
                                        <button type="button" 
                                                class="btn btn-danger btn-sm rounded-pill px-3" 
                                                data-bs-toggle="modal" 
                                                data-bs-target="#deleteModal-@item.Electronic_Id">
                                            <i class="fas fa-trash-alt me-1"></i> Delete
                                        </button>
                                    </div>

                                    <!-- Delete Modal --> 
                                    <div class="modal fade" id="deleteModal-@item.Electronic_Id" tabindex="-1">
                                        <div class="modal-dialog modal-dialog-centered">
                                            <div class="modal-content">
                                                <div class="modal-header">
                                                    <h5 class="modal-title">Confirm Deletion</h5>
                                                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                                                </div>
                                                <div class="modal-body">
                                                    <p class="mb-0">Are you sure you want to delete this electronic item?</p>
                                                    <p class="text-muted small mb-0">This action cannot be undone.</p>
                                                </div>
                                                <div class="modal-footer">
                                                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                                                    <form action="@Url.Action("DeleteElectronic", "InventoryControl", new { id = item.Electronic_Id })" method="post">
                                                        <button type="submit" class="btn btn-danger">Delete</button>
                                                    </form>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>



@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        $(document).on('click', '[data-bs-toggle="modal"]', function (event) {
            let target = $(this).data('bs-target'); // Get the modal ID
            let modal = new bootstrap.Modal(document.querySelector(target)); // Initialize Bootstrap modal
            modal.show(); // Show the modal properly
        });


        function exportToExcel() {
            const table = document.getElementById('inventoryTable');
            const wb = XLSX.utils.table_to_book(table, {sheet: "Inventory"});
            XLSX.writeFile(wb, 'electronic_inventory.xlsx');
        }
    </script>
}