@model Inventory.Models.GetElectronicModel
@{
    Layout = "_Layout";
    ViewData["Title"] = "Item Master";
    var totalUnits = Model.Data?.Sum(x => x.Electronic_CRStock) ?? 0;
    var lowCount = Model.Data?.Count(x => x.Electronic_CRStock <= (x.Reorder_Level > 0 ? x.Reorder_Level : 10)) ?? 0;
}

<div class="page-hero">
    <div>
        <h1>Item Master</h1>
        <p>SKU, cost, reorder levels and warehouse bin locations — product master for the ERP.</p>
    </div>
    <div class="d-flex flex-wrap" style="gap:.5rem;">
        <a class="btn btn-fx" asp-action="AddElectronic"><i class="fas fa-plus mr-1"></i> Add item</a>
        <a class="btn btn-fx-outline" asp-action="BulkUpload"><i class="fas fa-file-excel mr-1"></i> Import Excel</a>
        <a class="btn btn-fx-outline" asp-action="LowStock"><i class="fas fa-exclamation-triangle mr-1"></i> Low stock</a>
        <a class="btn btn-fx-outline" asp-controller="Documents" asp-action="CreateGRN"><i class="fas fa-file-import mr-1"></i> Goods Receipt</a>
    </div>
</div>

<div class="fx-stats-row">
    <div class="fx-stat-card">
        <span class="fx-stat-icon"><i class="fas fa-boxes"></i></span>
        <div><span class="fx-stat-value">@(Model.Data?.Count ?? 0)</span><span class="fx-stat-label">SKUs</span></div>
    </div>
    <div class="fx-stat-card">
        <span class="fx-stat-icon info"><i class="fas fa-layer-group"></i></span>
        <div><span class="fx-stat-value">@totalUnits.ToString("N0")</span><span class="fx-stat-label">Units on hand</span></div>
    </div>
    <div class="fx-stat-card">
        <span class="fx-stat-icon warning"><i class="fas fa-bell"></i></span>
        <div><span class="fx-stat-value">@lowCount</span><span class="fx-stat-label">Below reorder</span></div>
    </div>
</div>

<div class="card fx-card mb-4">
    <div class="card-body">
        <form method="get" class="form-row align-items-end">
            <div class="form-group col-md-5 mb-md-0">
                <label class="small text-muted text-uppercase font-weight-bold">Search</label>
                <input type="text" name="search" value="@ViewBag.Search" class="form-control" placeholder="Name, brand, SKU, category…">
            </div>
            <div class="form-group col-md-4 mb-md-0">
                <label class="small text-muted text-uppercase font-weight-bold">Status</label>
                <select name="status" class="form-control">
                    <option value="">All statuses</option>
                    @foreach (var s in new[] { "Available", "Active", "Low Stock", "Out of Stock", "Discontinued" })
                    {
                        <option value="@s" selected="@(ViewBag.Status as string == s)">@s</option>
                    }
                </select>
            </div>
            <div class="form-group col-md-3 mb-0">
                <button type="submit" class="btn btn-fx btn-block"><i class="fas fa-filter mr-1"></i> Filter</button>
            </div>
        </form>
    </div>
</div>

<div class="card fx-card">
    <div class="card-body p-0">
        @if (Model.Data == null || !Model.Data.Any())
        {
            <div class="fx-empty">
                <i class="fas fa-box-open d-block"></i>
                <h5>No products found</h5>
                <p>Add a product or clear filters.</p>
                <a class="btn btn-fx" asp-action="AddElectronic">Add product</a>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table fx-table mb-0" id="inventoryTable">
                    <thead>
                        <tr>
                            <th>Product</th>
                            <th>SKU / Bin</th>
                            <th>Stock</th>
                            <th>Cost / Price</th>
                            <th>Warehouse</th>
                            <th>Status</th>
                            <th class="text-center">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model.Data)
                        {
                            var reorder = item.Reorder_Level > 0 ? item.Reorder_Level : 10;
                            var isLow = item.Electronic_CRStock <= reorder;
                            <tr>
                                <td>
                                    <div class="font-weight-bold">@item.Electronic_Name</div>
                                    <div class="small text-muted">@item.Electronic_Brand · @item.Electronic_Sub_Category</div>
                                    @if (!string.IsNullOrWhiteSpace(item.Model_Number))
                                    {
                                        <div class="small text-muted">Model: @item.Model_Number</div>
                                    }
                                </td>
                                <td>
                                    <div>@(string.IsNullOrWhiteSpace(item.SKU) ? "—" : item.SKU)</div>
                                    <div class="small text-muted">Bin: @(item.Location_Bin ?? "—")</div>
                                </td>
                                <td>
                                    <span class="badge badge-fx @(isLow ? "badge-fx-warning" : "badge-fx-success")">@item.Electronic_CRStock</span>
                                    <div class="small text-muted">Reorder @reorder · Min @item.Min_Stock</div>
                                </td>
                                <td>
                                    <div>Sell @item.Electronic_Price.ToString("C0")</div>
                                    <div class="small text-muted">Cost @item.Unit_Cost.ToString("C2")</div>
                                </td>
                                <td>@(item.Default_Warehouse_Name ?? "—")</td>
                                <td><span class="badge badge-fx badge-fx-info">@item.Electronic_Status</span></td>
                                <td class="text-center text-nowrap">
                                    <a class="btn btn-sm btn-fx-outline" asp-action="AdjustStock" asp-route-id="@item.Electronic_Id" title="Adjust">Stock</a>
                                    <a class="btn btn-sm btn-fx" asp-action="EditElectronic" asp-route-id="@item.Electronic_Id">Edit</a>
                                    <button type="button" class="btn btn-sm btn-outline-danger" data-toggle="modal" data-target="#del-@item.Electronic_Id">Del</button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>

@foreach (var item in Model.Data ?? Enumerable.Empty<GetElectronicModel>())
{
    <div class="modal fade fx-modal" id="del-@item.Electronic_Id" tabindex="-1">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-body text-center p-4">
                    <h5>Delete “@item.Electronic_Name”?</h5>
                    <p class="text-muted">This cannot be undone.</p>
                </div>
                <div class="modal-footer justify-content-center">
                    <button type="button" class="btn btn-fx-outline" data-dismiss="modal">Cancel</button>
                    <form asp-action="DeleteElectronic" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="id" value="@item.Electronic_Id" />
                        <button type="submit" class="btn btn-danger">Delete</button>
                    </form>
                </div>
            </div>
        </div>
    </div>
}
