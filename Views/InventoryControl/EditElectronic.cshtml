@model Inventory.Models.ElectronicModel
@{
    Layout = "_Layout";
    ViewData["Title"] = "Edit Product";
}

<div class="fx-form-page">
<div class="page-hero">
    <div>
        <h1>Edit product</h1>
        <p>Update catalog, costing and reorder policy for “@Model.Electronic_Name”.</p>
    </div>
    <a asp-action="GetElectronicData" class="btn btn-fx-outline"><i class="fas fa-arrow-left mr-2"></i>Back</a>
</div>

<div class="fx-form-shell">
    <div class="card fx-card fx-form-card">
        <div class="card-header">
            <span class="fx-form-icon"><i class="fas fa-pen"></i></span>
            <div><strong>Product #@Model.Electronic_Id</strong><div class="small text-muted">EditElectronic stored procedure</div></div>
        </div>
        <div class="card-body">
            <form asp-action="EditElectronic" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="Electronic_Id">
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                <h6 class="text-uppercase text-muted font-weight-bold mb-3">Identity</h6>
                <div class="form-row">
                    <div class="form-group col-md-4">
                        <label asp-for="Electronic_Sub_Category"></label>
                        <select asp-for="Electronic_Sub_Category" asp-items="ViewBag.Categories" class="form-control"></select>
                    </div>
                    <div class="form-group col-md-4">
                        <label asp-for="Electronic_Supplier"></label>
                        <select asp-for="Electronic_Supplier" asp-items="ViewBag.Suppliers" class="form-control"></select>
                    </div>
                    <div class="form-group col-md-4">
                        <label asp-for="Electronic_Status"></label>
                        <select asp-for="Electronic_Status" class="form-control">
                            <option>Available</option>
                            <option>Active</option>
                            <option>Low Stock</option>
                            <option>Out of Stock</option>
                            <option>Discontinued</option>
                        </select>
                    </div>
                </div>
                <div class="form-row">
                    <div class="form-group col-md-4">
                        <label asp-for="Electronic_Brand"></label>
                        <input asp-for="Electronic_Brand" class="form-control">
                    </div>
                    <div class="form-group col-md-4">
                        <label asp-for="Electronic_Name"></label>
                        <input asp-for="Electronic_Name" class="form-control" autofocus>
                    </div>
                    <div class="form-group col-md-4">
                        <label asp-for="Model_Number"></label>
                        <input asp-for="Model_Number" class="form-control">
                    </div>
                </div>
                <div class="form-row">
                    <div class="form-group col-md-3">
                        <label asp-for="SKU"></label>
                        <input asp-for="SKU" class="form-control">
                    </div>
                    <div class="form-group col-md-3">
                        <label asp-for="Barcode"></label>
                        <input asp-for="Barcode" class="form-control">
                    </div>
                    <div class="form-group col-md-3">
                        <label asp-for="Manufacturer"></label>
                        <input asp-for="Manufacturer" class="form-control">
                    </div>
                    <div class="form-group col-md-3">
                        <label asp-for="HSN_Code"></label>
                        <input asp-for="HSN_Code" class="form-control">
                    </div>
                </div>

                <h6 class="text-uppercase text-muted font-weight-bold mb-3 mt-2">Pricing &amp; stock policy</h6>
                <div class="form-row">
                    <div class="form-group col-md-3">
                        <label asp-for="Unit_Cost"></label>
                        <input asp-for="Unit_Cost" class="form-control" type="number" step="0.01" min="0">
                    </div>
                    <div class="form-group col-md-3">
                        <label asp-for="Electronic_Price"></label>
                        <input asp-for="Electronic_Price" class="form-control" type="number" min="0">
                    </div>
                    <div class="form-group col-md-3">
                        <label asp-for="Tax_Percent"></label>
                        <input asp-for="Tax_Percent" class="form-control" type="number" step="0.01" min="0">
                    </div>
                    <div class="form-group col-md-3">
                        <label asp-for="Unit_Of_Measure"></label>
                        <select asp-for="Unit_Of_Measure" class="form-control">
                            <option>PCS</option>
                            <option>BOX</option>
                            <option>SET</option>
                            <option>KG</option>
                            <option>LTR</option>
                        </select>
                    </div>
                </div>
                <div class="form-row">
                    <div class="form-group col-md-3">
                        <label asp-for="Electronic_CRStock"></label>
                        <input asp-for="Electronic_CRStock" class="form-control" type="number" min="0">
                        <span class="fx-field-hint">Prefer GRN / DCN / Adjust for movements.</span>
                    </div>
                    <div class="form-group col-md-3">
                        <label asp-for="Reorder_Level"></label>
                        <input asp-for="Reorder_Level" class="form-control" type="number" min="0">
                    </div>
                    <div class="form-group col-md-3">
                        <label asp-for="Min_Stock"></label>
                        <input asp-for="Min_Stock" class="form-control" type="number" min="0">
                    </div>
                    <div class="form-group col-md-3">
                        <label asp-for="Max_Stock"></label>
                        <input asp-for="Max_Stock" class="form-control" type="number" min="0">
                    </div>
                </div>

                <h6 class="text-uppercase text-muted font-weight-bold mb-3 mt-2">Location &amp; notes</h6>
                <div class="form-row">
                    <div class="form-group col-md-4">
                        <label asp-for="Default_Warehouse_Id"></label>
                        <select asp-for="Default_Warehouse_Id" asp-items="ViewBag.Warehouses" class="form-control"></select>
                    </div>
                    <div class="form-group col-md-4">
                        <label asp-for="Location_Bin"></label>
                        <input asp-for="Location_Bin" class="form-control">
                    </div>
                    <div class="form-group col-md-4">
                        <label asp-for="Electronic_Warrenty_Period"></label>
                        <input asp-for="Electronic_Warrenty_Period" class="form-control" type="date">
                    </div>
                </div>
                <div class="form-group">
                    <label asp-for="Electronic_Specs"></label>
                    <textarea asp-for="Electronic_Specs" class="form-control" rows="2"></textarea>
                </div>
                <div class="form-group">
                    <label asp-for="Notes"></label>
                    <textarea asp-for="Notes" class="form-control" rows="2"></textarea>
                </div>

                <div class="fx-form-actions">
                    <a asp-action="GetElectronicData" class="btn btn-fx-outline">Cancel</a>
                    <a class="btn btn-fx-outline" asp-action="AdjustStock" asp-route-id="@Model.Electronic_Id">Adjust stock</a>
                    <button type="submit" class="btn btn-fx"><i class="fas fa-save mr-2"></i>Save changes</button>
                </div>
            </form>
        </div>
    </div>
</div>
</div>
