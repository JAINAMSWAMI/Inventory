@model Inventory.Models.GetElectronicModel
@{
    ViewData["Title"] = "Low Stock";
    Layout = "_Layout";
}

<div class="page-hero">
    <div>
        <h1>Low stock alerts</h1>
        <p>Items at or below reorder threshold — replenish with a vendor GRN.</p>
    </div>
    <div class="d-flex flex-wrap" style="gap:.5rem;">
        <a class="btn btn-fx" asp-controller="Documents" asp-action="CreateGRN"><i class="fas fa-file-import mr-1"></i> Create GRN</a>
        <a class="btn btn-fx-outline" asp-action="GetElectronicData">All products</a>
    </div>
</div>

<div class="card fx-card">
    <div class="card-body p-0">
        @if (Model.Data == null || !Model.Data.Any())
        {
            <div class="fx-empty">
                <i class="fas fa-check-circle d-block text-success"></i>
                <h5>Stock looks healthy</h5>
                <p>No products are below the low-stock threshold.</p>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table fx-table mb-0">
                    <thead>
                        <tr>
                            <th>Product</th>
                            <th>SKU</th>
                            <th>On hand</th>
                            <th>Reorder</th>
                            <th>Supplier</th>
                            <th>Warehouse</th>
                            <th class="text-center">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model.Data)
                        {
                            var reorder = item.Reorder_Level > 0 ? item.Reorder_Level : 10;
                            <tr>
                                <td>
                                    <div class="font-weight-bold">@item.Electronic_Name</div>
                                    <div class="small text-muted">@item.Electronic_Brand · @item.Electronic_Sub_Category</div>
                                </td>
                                <td>@(item.SKU ?? "—")</td>
                                <td><span class="badge badge-fx badge-fx-warning">@item.Electronic_CRStock</span></td>
                                <td>@reorder <span class="small text-muted">(min @item.Min_Stock)</span></td>
                                <td>@item.Electronic_Supplier</td>
                                <td>@(item.Default_Warehouse_Name ?? "—")</td>
                                <td class="text-center text-nowrap">
                                    <a class="btn btn-sm btn-fx" asp-controller="Documents" asp-action="CreateGRN">GRN</a>
                                    <a class="btn btn-sm btn-fx-outline" asp-action="AdjustStock" asp-route-id="@item.Electronic_Id">Adjust</a>
                                    <a class="btn btn-sm btn-fx-outline" asp-action="EditElectronic" asp-route-id="@item.Electronic_Id">Edit</a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>
