@model Inventory.Models.StockAdjustModel
@{
    ViewData["Title"] = "Adjust Stock";
    Layout = "_Layout";
}

<div class="page-hero">
    <div>
        <h1>Adjust stock</h1>
        <p>@Model.Electronic_Name · current stock @Model.CurrentStock</p>
    </div>
</div>

<div class="row">
    <div class="col-lg-5">
        <div class="card fx-card">
            <div class="card-body">
                <form asp-action="AdjustStock" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="Electronic_Id" />
                    <input type="hidden" asp-for="Electronic_Name" />
                    <input type="hidden" asp-for="CurrentStock" />
                    <div class="form-group">
                        <label asp-for="QuantityDelta">Quantity change (+ receive / − issue)</label>
                        <input asp-for="QuantityDelta" type="number" class="form-control" required />
                        <span asp-validation-for="QuantityDelta" class="text-danger"></span>
                    </div>
                    <div class="form-group">
                        <label asp-for="Reason">Reason</label>
                        <input asp-for="Reason" class="form-control" placeholder="e.g. Restock from PO-102" />
                    </div>
                    <button type="submit" class="btn btn-fx">Apply adjustment</button>
                    <a asp-action="GetElectronicData" class="btn btn-fx-outline">Cancel</a>
                </form>
            </div>
        </div>
    </div>
</div>
