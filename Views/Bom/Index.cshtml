@model Inventory.Models.ProductKitPageModel
@{
    Layout = "_Layout";
    ViewData["Title"] = "Product Kit";
    var productRows = ViewBag.ProductOptions as System.Data.DataTable;
}

<div class="page-hero">
    <div>
        <h1>Product Kit</h1>
        <p>Master list of frequently used products — select multiple and save, then load them on Create Order.</p>
    </div>
    <a asp-controller="Distribution" asp-action="CreateOrder" class="btn btn-fx-outline">
        <i class="fas fa-shipping-fast mr-1"></i> Create Order
    </a>
</div>

<div class="row">
    <div class="col-lg-5 mb-4">
        <div class="card fx-card fx-form-card">
            <div class="card-header d-flex justify-content-between align-items-center">
                <strong>Add products to @Model.KitName</strong>
                <button type="button" class="btn btn-sm btn-fx-outline" id="btnSelectAll">Select all</button>
            </div>
            <div class="card-body p-0">
                <form asp-action="Add" method="post" id="kitAddForm">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="KitId" />
                    @if (Model.AddLines.Count == 0)
                    {
                        <div class="fx-empty py-4">All catalog products are already in this kit.</div>
                    }
                    else
                    {
                        <div class="table-responsive" style="max-height:420px;overflow:auto;">
                            <table class="table fx-table mb-0">
                                <thead>
                                    <tr>
                                        <th style="width:40px;"></th>
                                        <th>Product</th>
                                        <th style="width:90px;" class="text-right">Qty</th>
                                    </tr>
                                </thead>
                                <tbody>
                                @for (var i = 0; i < Model.AddLines.Count; i++)
                                {
                                    var line = Model.AddLines[i];
                                    var label = line.ProductId.ToString();
                                    if (productRows != null)
                                    {
                                        foreach (System.Data.DataRow row in productRows.Rows)
                                        {
                                            if (Convert.ToInt32(row["Electronic_Id"]) == line.ProductId)
                                            {
                                                label = $"{row["Electronic_Brand"]} · {row["Electronic_Name"]} (Stock: {row["Electronic_CRStock"]})";
                                                break;
                                            }
                                        }
                                    }
                                    <tr>
                                        <td>
                                            <input type="hidden" name="AddLines[@i].ProductId" value="@line.ProductId" />
                                            <input type="checkbox" name="AddLines[@i].Selected" value="true" class="kit-select" />
                                        </td>
                                        <td class="small">@label</td>
                                        <td>
                                            <input type="text" name="AddLines[@i].DefaultQuantity" value="@line.DefaultQuantity"
                                                   class="form-control form-control-sm fx-num text-right" inputmode="numeric" autocomplete="off" />
                                        </td>
                                    </tr>
                                }
                                </tbody>
                            </table>
                        </div>
                        <div class="p-3 border-top">
                            <button type="submit" class="btn btn-fx btn-block">
                                <i class="fas fa-plus mr-1"></i> Add selected products
                            </button>
                        </div>
                    }
                </form>
            </div>
        </div>
    </div>

    <div class="col-lg-7 mb-4">
        <div class="card fx-card">
            <div class="card-header d-flex justify-content-between align-items-center">
                <strong>@Model.KitName</strong>
                <span class="badge badge-fx badge-fx-info">@Model.Items.Count items</span>
            </div>
            <div class="card-body p-0">
                @if (!Model.Items.Any())
                {
                    <div class="fx-empty py-5">No products in this kit yet. Select multiple on the left and save.</div>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table fx-table mb-0">
                            <thead>
                                <tr>
                                    <th>Product</th>
                                    <th class="text-right">Stock</th>
                                    <th class="text-right">Default qty</th>
                                    <th class="text-right">Sell price</th>
                                    <th></th>
                                </tr>
                            </thead>
                            <tbody>
                            @foreach (var item in Model.Items)
                            {
                                <tr>
                                    <td>
                                        <div class="font-weight-bold">@item.Brand · @item.ProductName</div>
                                    </td>
                                    <td class="text-right">@item.StockOnHand</td>
                                    <td class="text-right">@item.DefaultQuantity</td>
                                    <td class="text-right">@item.SellPrice.ToString("C0")</td>
                                    <td class="text-right">
                                        <form asp-action="Delete" method="post" class="d-inline">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="id" value="@item.KitItemId" />
                                            <button type="submit" class="btn btn-fx-icon danger" title="Remove">
                                                <i class="fas fa-trash-alt"></i>
                                            </button>
                                        </form>
                                    </td>
                                </tr>
                            }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
(function () {
    var btn = document.getElementById('btnSelectAll');
    if (!btn) return;
    var all = false;
    btn.addEventListener('click', function () {
        all = !all;
        document.querySelectorAll('.kit-select').forEach(function (cb) { cb.checked = all; });
        btn.textContent = all ? 'Clear all' : 'Select all';
    });
})();
</script>
}
