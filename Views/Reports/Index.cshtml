@model Inventory.Models.ReportViewModel
@{
    Layout = "_Layout";
    ViewData["Title"] = "Reports";
    string Active(string t) => Model.ReportType == t ? "btn-fx" : "btn-fx-outline";
}

<div class="page-hero">
    <div>
        <h1>Inventory reports</h1>
        <p>Valuation, GRN inbound, DCN outbound and stock movement ledger.</p>
    </div>
</div>

<div class="card fx-card mb-4">
    <div class="card-body">
        <form method="get" class="form-row align-items-end">
            <div class="form-group col-md-3 mb-md-0">
                <label class="small text-muted text-uppercase font-weight-bold">Report</label>
                <select name="type" class="form-control">
                    <option value="valuation" selected="@(Model.ReportType == "valuation")">Inventory valuation</option>
                    <option value="grn" selected="@(Model.ReportType == "grn")">GRN report</option>
                    <option value="dcn" selected="@(Model.ReportType == "dcn")">DCN report</option>
                    <option value="movements" selected="@(Model.ReportType == "movements")">Stock movements</option>
                </select>
            </div>
            <div class="form-group col-md-3 mb-md-0">
                <label class="small text-muted text-uppercase font-weight-bold">From</label>
                <input type="date" name="from" class="form-control" value="@(Model.FromDate?.ToString("yyyy-MM-dd"))" />
            </div>
            <div class="form-group col-md-3 mb-md-0">
                <label class="small text-muted text-uppercase font-weight-bold">To</label>
                <input type="date" name="to" class="form-control" value="@(Model.ToDate?.ToString("yyyy-MM-dd"))" />
            </div>
            <div class="form-group col-md-3 mb-0">
                <button type="submit" class="btn btn-fx btn-block"><i class="fas fa-sync mr-1"></i> Run</button>
            </div>
        </form>
        <div class="mt-3 d-flex flex-wrap" style="gap:.5rem;">
            <a class="btn btn-sm @Active("valuation")" asp-action="Index" asp-route-type="valuation">Valuation</a>
            <a class="btn btn-sm @Active("grn")" asp-action="Index" asp-route-type="grn">GRN</a>
            <a class="btn btn-sm @Active("dcn")" asp-action="Index" asp-route-type="dcn">DCN</a>
            <a class="btn btn-sm @Active("movements")" asp-action="Index" asp-route-type="movements">Movements</a>
        </div>
    </div>
</div>

<div class="card fx-card">
    <div class="card-header d-flex justify-content-between">
        <strong>@(Model.ReportType switch {
            "grn" => "GRN report",
            "dcn" => "DCN report",
            "movements" => "Stock movement report",
            _ => "Inventory valuation"
        })</strong>
        <span class="small text-muted">@Model.Rows.Count rows</span>
    </div>
    <div class="card-body p-0">
        @if (!Model.Rows.Any())
        {
            <div class="fx-empty">No data for this report yet. Post GRN or DCN documents to populate it.</div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table fx-table mb-0">
                    <thead>
                        <tr>
                            @foreach (var col in Model.Columns)
                            {
                                <th>@col.Replace("_", " ")</th>
                            }
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var row in Model.Rows)
                        {
                            <tr>
                                @foreach (var col in Model.Columns)
                                {
                                    var val = row.ContainsKey(col) ? row[col] : null;
                                    <td>
                                        @if (val is DateTime dt)
                                        {
                                            @dt.ToString("dd MMM yyyy")
                                        }
                                        else if (val is decimal dec)
                                        {
                                            @dec.ToString("N2")
                                        }
                                        else
                                        {
                                            @(val?.ToString() ?? "—")
                                        }
                                    </td>
                                }
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>
