@model Inventory.Models.DCNModel
@{
    Layout = "_Layout";
    ViewData["Title"] = "Create DCN";
    if (Model.LineItems == null || Model.LineItems.Count == 0)
        Model.LineItems = new List<Inventory.Models.DCNLineItemModel> { new() };
}

<div class="fx-form-page">
<div class="page-hero">
    <div>
        <h1>Delivery Challan Note</h1>
        <p>Dispatch stock to a <strong>customer</strong> or transfer to another <strong>warehouse</strong>.</p>
    </div>
    <a asp-action="Index" class="btn btn-fx-outline"><i class="fas fa-arrow-left mr-2"></i>Documents</a>
</div>

<div class="fx-form-shell fx-form-shell-wide">
    <div class="card fx-card fx-form-card">
        <div class="card-header">
            <span class="fx-form-icon"><i class="fas fa-file-export"></i></span>
            <div><strong>Outbound DCN</strong><div class="small text-muted">Customer: pick order → products load · FIFO COGS · WH transfer logs move</div></div>
        </div>
        <div class="card-body">
            <form asp-action="CreateDCN" method="post" id="dcnForm" autocomplete="off">
                @Html.AntiForgeryToken()
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                <div class="form-row">
                    <div class="form-group col-md-4">
                        <label asp-for="DCN_Date"></label>
                        <input asp-for="DCN_Date" class="form-control" type="date">
                    </div>
                    <div class="form-group col-md-4">
                        <label asp-for="Party_Type"></label>
                        <select asp-for="Party_Type" class="form-control" id="Party_Type">
                            <option value="Customer">Customer (sale / delivery)</option>
                            <option value="Warehouse">Warehouse (transfer out)</option>
                        </select>
                    </div>
                    <div class="form-group col-md-4">
                        <label asp-for="Delivered_By"></label>
                        <input asp-for="Delivered_By" class="form-control">
                    </div>
                </div>

                <div id="customerBlock">
                    <div class="form-row">
                        <div class="form-group col-md-4">
                            <label asp-for="Customer_Name"></label>
                            <div class="fx-ac">
                                <input asp-for="Customer_Name" class="form-control" id="Customer_Name" placeholder="Type 3+ letters…" autocomplete="off">
                                <div class="fx-ac-menu" id="customerMenu" hidden></div>
                            </div>
                            <span asp-validation-for="Customer_Name" class="text-danger"></span>
                        </div>
                        <div class="form-group col-md-4">
                            <label asp-for="Customer_Phone"></label>
                            <input asp-for="Customer_Phone" class="form-control" id="Customer_Phone">
                        </div>
                        <div class="form-group col-md-4">
                            <label asp-for="Customer_Email"></label>
                            <input asp-for="Customer_Email" class="form-control" id="Customer_Email" type="email">
                        </div>
                    </div>
                    <div class="form-row">
                        <div class="form-group col-md-4">
                            <label asp-for="Order_No"></label>
                            <select asp-for="Order_No" class="form-control" id="Order_No">
                                <option value="">-- Select linked order --</option>
                                @if (!string.IsNullOrWhiteSpace(Model.Order_No))
                                {
                                    <option value="@Model.Order_No" selected>@Model.Order_No</option>
                                }
                            </select>
                        </div>
                        <div class="form-group col-md-4">
                            <label asp-for="Billing_Company"></label>
                            <select asp-for="Billing_Company" asp-items="ViewBag.BillingCompanies" class="form-control" id="Billing_Company">
                                <option value="">-- Select billing company --</option>
                            </select>
                        </div>
                        <div class="form-group col-md-4">
                            <label asp-for="PO_Number"></label>
                            <input asp-for="PO_Number" class="form-control" id="PO_Number">
                        </div>
                    </div>
                    <div class="form-row">
                        <div class="form-group col-md-4">
                            <label asp-for="Customer_GSTIN"></label>
                            <input asp-for="Customer_GSTIN" class="form-control" id="Customer_GSTIN">
                        </div>
                        <div class="form-group col-md-4">
                            <label asp-for="Pincode"></label>
                            <input asp-for="Pincode" class="form-control" id="Pincode">
                        </div>
                        <div class="form-group col-md-4">
                            <label asp-for="Customer_Address"></label>
                            <input asp-for="Customer_Address" class="form-control" id="Customer_Address">
                        </div>
                    </div>
                </div>

                <div class="form-row" id="whBlock">
                    <div class="form-group col-md-6" id="fromWhRow">
                        <label asp-for="From_Warehouse_Id"></label>
                        <select asp-for="From_Warehouse_Id" asp-items="ViewBag.Warehouses" class="form-control"></select>
                        <span asp-validation-for="From_Warehouse_Id" class="text-danger"></span>
                    </div>
                    <div class="form-group col-md-6" id="toWhRow" style="display:none;">
                        <label asp-for="To_Warehouse_Id"></label>
                        <select asp-for="To_Warehouse_Id" asp-items="ViewBag.Warehouses" class="form-control"></select>
                        <span asp-validation-for="To_Warehouse_Id" class="text-danger"></span>
                    </div>
                </div>

                <div class="form-row">
                    <div class="form-group col-md-4">
                        <label asp-for="Vehicle_No"></label>
                        <input asp-for="Vehicle_No" class="form-control">
                    </div>
                    <div class="form-group col-md-4">
                        <label asp-for="Transporter"></label>
                        <input asp-for="Transporter" class="form-control">
                    </div>
                    <div class="form-group col-md-4">
                        <label asp-for="Remarks"></label>
                        <input asp-for="Remarks" class="form-control">
                    </div>
                </div>

                <div id="customerLines">
                    <h6 class="text-uppercase text-muted font-weight-bold mb-2 mt-2">Line items</h6>
                    <p class="small text-muted mb-2">Products load automatically from the linked order. FIFO COGS is applied on post.</p>
                    <div class="table-responsive fx-line-table-wrap mb-3">
                        <table class="table fx-line-table mb-0" id="dcnLines">
                            <thead>
                                <tr>
                                    <th>Product</th>
                                    <th style="width:100px;">Qty</th>
                                    <th style="width:120px;">Unit price</th>
                                </tr>
                            </thead>
                            <tbody>
                            @for (var i = 0; i < Model.LineItems.Count; i++)
                            {
                                <tr>
                                    <td>
                                        <input type="hidden" name="LineItems[@i].Electronic_Id" class="fx-line-id" value="@(Model.LineItems[i].Electronic_Id > 0 ? Model.LineItems[i].Electronic_Id.ToString() : "")" />
                                        <input type="text" name="LineItems[@i].Product_Label" class="form-control" readonly
                                               value="@Model.LineItems[i].Product_Label" placeholder="Select linked order…" />
                                    </td>
                                    <td>
                                        <input type="text" name="LineItems[@i].Quantity" class="form-control fx-num"
                                               value="@(Model.LineItems[i].Quantity > 0 ? Model.LineItems[i].Quantity.ToString() : "")"
                                               inputmode="numeric" autocomplete="off" />
                                    </td>
                                    <td>
                                        <input type="text" name="LineItems[@i].Unit_Price" class="form-control fx-num"
                                               value="@(Model.LineItems[i].Unit_Price?.ToString(System.Globalization.CultureInfo.InvariantCulture))"
                                               inputmode="decimal" autocomplete="off" />
                                    </td>
                                </tr>
                            }
                            </tbody>
                        </table>
                    </div>
                </div>

                <div id="warehouseLine" style="display:none;">
                    <h6 class="text-uppercase text-muted font-weight-bold mb-3 mt-2">Line item</h6>
                    <div class="form-row">
                        <div class="form-group col-md-6">
                            <label asp-for="Electronic_Id"></label>
                            <select asp-for="Electronic_Id" asp-items="ViewBag.Products" class="form-control"></select>
                        </div>
                        <div class="form-group col-md-3">
                            <label asp-for="Quantity"></label>
                            <input asp-for="Quantity" class="form-control fx-num" type="text" inputmode="numeric" autocomplete="off">
                        </div>
                        <div class="form-group col-md-3">
                            <label asp-for="Unit_Price"></label>
                            <input asp-for="Unit_Price" class="form-control fx-num" type="text" inputmode="decimal" autocomplete="off">
                        </div>
                    </div>
                </div>

                <div class="fx-form-actions">
                    <a asp-action="Index" class="btn btn-fx-outline">Cancel</a>
                    <button type="submit" class="btn btn-fx"><i class="fas fa-check mr-2"></i>Post DCN</button>
                </div>
            </form>
        </div>
    </div>
</div>
</div>

@section Scripts {
<script>
(function () {
    const party = document.getElementById('Party_Type');
    const customerBlock = document.getElementById('customerBlock');
    const fromWh = document.getElementById('fromWhRow');
    const toWh = document.getElementById('toWhRow');
    const customerLines = document.getElementById('customerLines');
    const warehouseLine = document.getElementById('warehouseLine');
    const nameInput = document.getElementById('Customer_Name');
    const menu = document.getElementById('customerMenu');
    const orderSel = document.getElementById('Order_No');
    const tbody = document.querySelector('#dcnLines tbody');

    function syncParty() {
        const isCust = party.value === 'Customer';
        customerBlock.style.display = isCust ? '' : 'none';
        customerLines.style.display = isCust ? '' : 'none';
        warehouseLine.style.display = isCust ? 'none' : '';
        fromWh.style.display = isCust ? 'none' : '';
        toWh.style.display = isCust ? 'none' : '';
    }
    party.addEventListener('change', syncParty);
    syncParty();

    function esc(s) {
        return String(s == null ? '' : s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;');
    }

    let timer;
    nameInput.addEventListener('input', function () {
        clearTimeout(timer);
        const q = nameInput.value.trim();
        if (q.length < 3) { menu.hidden = true; menu.innerHTML = ''; return; }
        timer = setTimeout(function () {
            fetch('@Url.Action("SearchCustomers", "Documents")?q=' + encodeURIComponent(q))
                .then(r => r.json())
                .then(function (data) {
                    const items = (data && data.items) || [];
                    if (!items.length) {
                        menu.innerHTML = '<div class="fx-ac-empty">No matching customers</div>';
                        menu.hidden = false;
                        return;
                    }
                    menu.innerHTML = items.map(function (c) {
                        return '<button type="button" class="fx-ac-option" data-name="' + esc(c.name) +
                            '" data-email="' + esc(c.email) + '" data-phone="' + esc(c.phone) +
                            '" data-address="' + esc(c.address) + '" data-billing="' + esc(c.billing) +
                            '" data-pincode="' + esc(c.pincode) + '"><span class="fx-ac-title">' + esc(c.name) +
                            '</span><span class="fx-ac-meta">' + esc(c.phone || c.email || '') + '</span></button>';
                    }).join('');
                    menu.hidden = false;
                });
        }, 250);
    });

    menu.addEventListener('mousedown', function (e) {
        const opt = e.target.closest('.fx-ac-option');
        if (!opt) return;
        e.preventDefault();
        nameInput.value = opt.getAttribute('data-name') || '';
        document.getElementById('Customer_Email').value = opt.getAttribute('data-email') || '';
        document.getElementById('Customer_Phone').value = opt.getAttribute('data-phone') || '';
        document.getElementById('Customer_Address').value = opt.getAttribute('data-address') || '';
        document.getElementById('Billing_Company').value = opt.getAttribute('data-billing') || '';
        document.getElementById('Pincode').value = opt.getAttribute('data-pincode') || '';
        menu.hidden = true;
        loadOrders(nameInput.value);
    });

    document.addEventListener('click', function (e) {
        if (!e.target.closest('#customerBlock .fx-ac')) menu.hidden = true;
    });

    function loadOrders(name) {
        orderSel.innerHTML = '<option value="">Loading…</option>';
        fetch('@Url.Action("OrdersByCustomer", "Documents")?name=' + encodeURIComponent(name))
            .then(r => r.json())
            .then(function (data) {
                const orders = (data && data.orders) || [];
                orderSel.innerHTML = '<option value="">-- Select linked order --</option>' +
                    orders.map(function (o) {
                        return '<option value="' + esc(o.orderNo) + '">' + esc(o.orderNo) + ' · ' +
                            esc(o.orderDate) + ' · ' + esc(o.status) + ' · ₹' + Number(o.total || 0).toLocaleString() + '</option>';
                    }).join('');
            });
    }

    function setLines(items) {
        if (!items || !items.length) {
            tbody.innerHTML = '<tr><td colspan="3" class="text-muted small px-3 py-3">No products on this order.</td></tr>';
            return;
        }
        tbody.innerHTML = items.map(function (it, i) {
            return '<tr><td><input type="hidden" name="LineItems[' + i + '].Electronic_Id" value="' + it.electronicId + '" />' +
                '<input type="text" name="LineItems[' + i + '].Product_Label" class="form-control" readonly value="' + esc(it.label) + '" /></td>' +
                '<td><input type="text" name="LineItems[' + i + '].Quantity" class="form-control fx-num" inputmode="numeric" value="' + it.quantity + '" /></td>' +
                '<td><input type="text" name="LineItems[' + i + '].Unit_Price" class="form-control fx-num" inputmode="decimal" value="' + (it.unitPrice || '') + '" /></td></tr>';
        }).join('');
    }

    orderSel.addEventListener('change', function () {
        const no = orderSel.value;
        if (!no) { setLines([]); return; }
        fetch('@Url.Action("OrderItems", "Documents")?orderNo=' + encodeURIComponent(no))
            .then(r => r.json())
            .then(function (data) {
                if (data && data.header) {
                    const h = data.header;
                    if (h.email) document.getElementById('Customer_Email').value = h.email;
                    if (h.phone) document.getElementById('Customer_Phone').value = h.phone;
                    if (h.address) document.getElementById('Customer_Address').value = h.address;
                    if (h.billing) document.getElementById('Billing_Company').value = h.billing;
                    if (h.po) document.getElementById('PO_Number').value = h.po;
                    if (h.pincode) document.getElementById('Pincode').value = h.pincode;
                }
                setLines((data && data.items) || []);
            });
    });

    if (nameInput.value.trim().length >= 3) loadOrders(nameInput.value.trim());
})();
</script>
}
