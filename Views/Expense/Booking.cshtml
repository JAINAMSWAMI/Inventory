@model IEnumerable<Inventory.Models.FinanceVoucherListItem>
@{
    Layout = "_Layout";
    ViewData["Title"] = "Expense Booking";
    string Inr(decimal n) => n.ToString("C4", System.Globalization.CultureInfo.GetCultureInfo("en-IN"));
}

<div class="page-hero d-flex justify-content-between align-items-start flex-wrap">
    <div>
        <h1>Expense Booking</h1>
        <p>Same voucher structure as payments — allocated to expense heads.</p>
    </div>
    <a asp-action="Create" class="btn btn-fx"><i class="fas fa-plus mr-1"></i> Book expense</a>
</div>

<div class="card fx-card">
    <div class="card-body p-0">
        @if (!Model.Any())
        {
            <div class="fx-empty py-5">No expenses yet.</div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table fx-table mb-0">
                    <thead>
                        <tr>
                            <th>Expense #</th>
                            <th>Date</th>
                            <th>Party</th>
                            <th>Mode</th>
                            <th>Status</th>
                            <th class="text-right">Amount</th>
                        </tr>
                    </thead>
                    <tbody>
                    @foreach (var r in Model)
                    {
                        <tr>
                            <td class="font-weight-bold">@r.DocumentNo</td>
                            <td>@r.PaymentDate.ToString("dd/MM/yyyy HH:mm")</td>
                            <td>@r.PartyName</td>
                            <td>@r.ModeName</td>
                            <td><span class="fx-badge @(r.ApprovalStatus == "Approved" ? "ok" : r.ApprovalStatus == "Rejected" ? "danger" : "warn")">@r.ApprovalStatus</span></td>
                            <td class="text-right">@Inr(r.PaymentAmount)</td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>
