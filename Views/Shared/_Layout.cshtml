@using System.Security.Claims
@using DataLayer
@using Inventory.Security
@{
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";
    var currentAction = ViewContext.RouteData.Values["action"]?.ToString() ?? "";
    Func<string, bool> canAccess = module => ModuleAccess.CanAccess(User, module);
    Func<string, string, bool> isPage = (controller, action) =>
        string.Equals(currentController, controller, StringComparison.OrdinalIgnoreCase) &&
        string.Equals(currentAction, action, StringComparison.OrdinalIgnoreCase);
    var catalogOpen = currentController is "InventoryControl" or "Category" or "MasterPrices";
    var partnersOpen = currentController is "Supplier" or "Warehouse";
    var inventoryOpsOpen = currentController is "Documents" or "StockReceive";
    var salesOpen = currentController is "Distribution" or "Bom";
    var financeOpen = currentController is "Payment" or "Expense" or "Invoice" or "Approval";
    var settingsOpen = currentController is "Settings" or "ApprovalWorkflow";
    var userRole = User?.FindFirst(ClaimTypes.Role)?.Value;
    if (string.IsNullOrWhiteSpace(userRole))
        userRole = User?.IsInRole("Admin") == true ? "Admin" : "User";
    var userEmail = User?.FindFirst(ClaimTypes.Email)?.Value;
    var pendingApprovals = 0;
    if (canAccess("Approvals") && int.TryParse(User?.FindFirst(ClaimTypes.NameIdentifier)?.Value, out var layoutUserId))
    {
        try { pendingApprovals = new ApprovalWorkflowStore().GetPendingForUser(layoutUserId).Rows.Count; }
        catch { /* keep nav resilient if approval DB is unavailable */ }
    }
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
    <title>@(ViewData["Title"] ?? "Fluxx ERP") · Fluxx ERP</title>

    <link href="~/vendor/fontawesome-free/css/all.min.css" rel="stylesheet" type="text/css">
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:ital,opsz,wght@0,9..40,400;0,9..40,500;0,9..40,600;0,9..40,700;1,9..40,400&family=Syne:wght@600;700;800&display=swap" rel="stylesheet">
    <link href="~/css/sb-admin-2.min.css" rel="stylesheet">
    <link href="~/css/fluxx-app.css" rel="stylesheet">
    @RenderSection("Styles", required: false)
</head>
<body id="page-top" class="fluxx-app">
    <div id="wrapper">
        <ul class="navbar-nav sidebar sidebar-dark accordion fluxx-sidebar" id="accordionSidebar">
            <a class="sidebar-brand d-flex align-items-center justify-content-center" asp-controller="Dashboard" asp-action="Index">
                <div class="sidebar-brand-icon">
                    <i class="fas fa-cube"></i>
                </div>
                <div class="sidebar-brand-text mx-2">Fluxx ERP</div>
            </a>

            <hr class="sidebar-divider my-0">

            <li class="nav-item @(currentController == "Dashboard" ? "active" : "")">
                <a class="nav-link" asp-controller="Dashboard" asp-action="Index">
                    <i class="fas fa-fw fa-tachometer-alt"></i>
                    <span>Command Center</span>
                </a>
            </li>

            @if (canAccess("Products") || canAccess("Categories") || canAccess("Pricing") ||
                 canAccess("Suppliers") || canAccess("Warehouses"))
            {
                <hr class="sidebar-divider">
                <div class="sidebar-heading">Masters</div>
            }

            @if (canAccess("Products") || canAccess("Categories") || canAccess("Pricing"))
            {
                <li class="nav-item @(catalogOpen ? "active" : "")">
                    <a class="nav-link @(catalogOpen ? "" : "collapsed")" href="#" data-toggle="collapse"
                       data-target="#collapseCatalog" aria-expanded="@(catalogOpen.ToString().ToLowerInvariant())"
                       aria-controls="collapseCatalog">
                        <i class="fas fa-fw fa-boxes"></i>
                        <span>Item Master</span>
                    </a>
                    <div id="collapseCatalog" class="collapse @(catalogOpen ? "show" : "")" data-parent="#accordionSidebar">
                        <div class="bg-white py-2 collapse-inner rounded">
                            <h6 class="collapse-header">Product Masters</h6>
                            @if (canAccess("Products"))
                            {
                                <a class="collapse-item @(currentController == "InventoryControl" ? "active" : "")"
                                   asp-controller="InventoryControl" asp-action="GetElectronicData">Item Master</a>
                            }
                            @if (canAccess("Categories"))
                            {
                                <a class="collapse-item @(currentController == "Category" ? "active" : "")"
                                   asp-controller="Category" asp-action="Index">Item Groups</a>
                            }
                            @if (canAccess("Pricing"))
                            {
                                <a class="collapse-item @(currentController == "MasterPrices" ? "active" : "")"
                                   asp-controller="MasterPrices" asp-action="Index">Price Lists</a>
                            }
                        </div>
                    </div>
                </li>
            }

            @if (canAccess("Suppliers") || canAccess("Warehouses"))
            {
                <li class="nav-item @(partnersOpen ? "active" : "")">
                    <a class="nav-link @(partnersOpen ? "" : "collapsed")" href="#" data-toggle="collapse"
                       data-target="#collapsePartners" aria-expanded="@(partnersOpen.ToString().ToLowerInvariant())"
                       aria-controls="collapsePartners">
                        <i class="fas fa-fw fa-building"></i>
                        <span>Business Partners</span>
                    </a>
                    <div id="collapsePartners" class="collapse @(partnersOpen ? "show" : "")" data-parent="#accordionSidebar">
                        <div class="bg-white py-2 collapse-inner rounded">
                            <h6 class="collapse-header">Party &amp; Sites</h6>
                            @if (canAccess("Suppliers"))
                            {
                                <a class="collapse-item @(currentController == "Supplier" ? "active" : "")"
                                   asp-controller="Supplier" asp-action="Index">Vendors</a>
                            }
                            @if (canAccess("Warehouses"))
                            {
                                <a class="collapse-item @(currentController == "Warehouse" ? "active" : "")"
                                   asp-controller="Warehouse" asp-action="Index">Warehouses</a>
                            }
                        </div>
                    </div>
                </li>
            }

            @if (canAccess("Documents") || canAccess("Stock"))
            {
                <hr class="sidebar-divider">
                <div class="sidebar-heading">Supply Chain</div>
                <li class="nav-item @(inventoryOpsOpen ? "active" : "")">
                    <a class="nav-link @(inventoryOpsOpen ? "" : "collapsed")" href="#" data-toggle="collapse"
                       data-target="#collapseOperations" aria-expanded="@(inventoryOpsOpen.ToString().ToLowerInvariant())"
                       aria-controls="collapseOperations">
                        <i class="fas fa-fw fa-exchange-alt"></i>
                        <span>Inventory Control</span>
                    </a>
                    <div id="collapseOperations" class="collapse @(inventoryOpsOpen ? "show" : "")" data-parent="#accordionSidebar">
                        <div class="bg-white py-2 collapse-inner rounded">
                            @if (canAccess("Documents"))
                            {
                                <h6 class="collapse-header">Goods Movement</h6>
                                <a class="collapse-item @(isPage("Documents", "Index") ? "active" : "")"
                                   asp-controller="Documents" asp-action="Index">Document Register</a>
                                <a class="collapse-item @(isPage("Documents", "CreateGRN") ? "active" : "")"
                                   asp-controller="Documents" asp-action="CreateGRN">Goods Receipt (GRN)</a>
                                <a class="collapse-item @(isPage("Documents", "CreateDCN") ? "active" : "")"
                                   asp-controller="Documents" asp-action="CreateDCN">Goods Issue (DCN)</a>
                            }
                            @if (canAccess("Stock"))
                            {
                                <h6 class="collapse-header">Stock Ledger</h6>
                                <a class="collapse-item @(isPage("StockReceive", "Index") || isPage("StockReceive", "Create") ? "active" : "")"
                                   asp-controller="StockReceive" asp-action="Index">Stock Ledger</a>
                                <a class="collapse-item @(isPage("StockReceive", "Movements") ? "active" : "")"
                                   asp-controller="StockReceive" asp-action="Movements">Stock Transfers</a>
                            }
                        </div>
                    </div>
                </li>
            }

            @if (canAccess("Orders"))
            {
                <hr class="sidebar-divider">
                <div class="sidebar-heading">Sales</div>
                <li class="nav-item @(salesOpen ? "active" : "")">
                    <a class="nav-link @(salesOpen ? "" : "collapsed")" href="#" data-toggle="collapse"
                       data-target="#collapseSales" aria-expanded="@(salesOpen.ToString().ToLowerInvariant())"
                       aria-controls="collapseSales">
                        <i class="fas fa-fw fa-shipping-fast"></i>
                        <span>Order Management</span>
                    </a>
                    <div id="collapseSales" class="collapse @(salesOpen ? "show" : "")" data-parent="#accordionSidebar">
                        <div class="bg-white py-2 collapse-inner rounded">
                            <h6 class="collapse-header">Sales &amp; Logistics</h6>
                            <a class="collapse-item @(isPage("Distribution", "CreateOrder") || isPage("Distribution", "OrderSuccess") ? "active" : "")"
                               asp-controller="Distribution" asp-action="CreateOrder">Sales Orders</a>
                            <a class="collapse-item @(currentController == "Bom" ? "active" : "")"
                               asp-controller="Bom" asp-action="Index">Bill of Materials</a>
                            <a class="collapse-item @(isPage("Distribution", "ViewShipment") ? "active" : "")"
                               asp-controller="Distribution" asp-action="ViewShipment">Shipment Register</a>
                            <a class="collapse-item @(isPage("Distribution", "Tracking") ? "active" : "")"
                               asp-controller="Distribution" asp-action="Tracking">Shipment Tracking</a>
                            <a class="collapse-item @(isPage("Distribution", "DistributionCenter") ? "active" : "")"
                               asp-controller="Distribution" asp-action="DistributionCenter">Distribution Centers</a>
                        </div>
                    </div>
                </li>
            }

            @if (canAccess("Invoices") || canAccess("Payments") || canAccess("Expenses") || canAccess("Approvals"))
            {
                <hr class="sidebar-divider">
                <div class="sidebar-heading">Finance</div>
                <li class="nav-item @(financeOpen ? "active" : "")">
                    <a class="nav-link @(financeOpen ? "" : "collapsed")" href="#" data-toggle="collapse"
                       data-target="#collapseFinance" aria-expanded="@(financeOpen.ToString().ToLowerInvariant())"
                       aria-controls="collapseFinance">
                        <i class="fas fa-fw fa-file-invoice-dollar"></i>
                        <span>Finance &amp; Accounts</span>
                    </a>
                    <div id="collapseFinance" class="collapse @(financeOpen ? "show" : "")" data-parent="#accordionSidebar">
                        <div class="bg-white py-2 collapse-inner rounded">
                            <h6 class="collapse-header">Financial Documents</h6>
                            @if (canAccess("Invoices"))
                            {
                                <a class="collapse-item @(currentController == "Invoice" ? "active" : "")"
                                   asp-controller="Invoice" asp-action="Index">Sales Invoices</a>
                            }
                            @if (canAccess("Payments"))
                            {
                                <a class="collapse-item @(isPage("Payment", "Receipts") || isPage("Payment", "Create") ? "active" : "")"
                                   asp-controller="Payment" asp-action="Receipts">Receipts &amp; Payments</a>
                            }
                            @if (canAccess("Expenses"))
                            {
                                <a class="collapse-item @(currentController == "Expense" ? "active" : "")"
                                   asp-controller="Expense" asp-action="Booking">Expense Vouchers</a>
                            }
                            @if (canAccess("Approvals"))
                            {
                                <a class="collapse-item @(currentController == "Approval" ? "active" : "")"
                                   asp-controller="Approval" asp-action="Inbox">
                                    Approval Inbox
                                    @if (pendingApprovals > 0)
                                    {
                                        <span class="fx-nav-badge">@pendingApprovals</span>
                                    }
                                </a>
                            }
                        </div>
                    </div>
                </li>
            }

            @if (canAccess("Reports"))
            {
                <hr class="sidebar-divider">
                <div class="sidebar-heading">Intelligence</div>
                <li class="nav-item @(currentController == "Reports" ? "active" : "")">
                    <a class="nav-link" asp-controller="Reports" asp-action="Index">
                        <i class="fas fa-fw fa-chart-bar"></i>
                        <span>Business Reports</span>
                    </a>
                </li>
            }

            @if (canAccess("Settings"))
            {
                <hr class="sidebar-divider">
                <div class="sidebar-heading">Administration</div>
                <li class="nav-item @(settingsOpen ? "active" : "")">
                    <a class="nav-link" asp-controller="Settings" asp-action="Index">
                        <i class="fas fa-fw fa-cog"></i>
                        <span>Settings</span>
                    </a>
                </li>
            }

            <hr class="sidebar-divider d-none d-md-block">
            <div class="text-center d-none d-md-inline">
                <button class="rounded-circle border-0" id="sidebarToggle" type="button"></button>
            </div>
        </ul>

        <div id="content-wrapper" class="d-flex flex-column">
            <div id="content">
                <nav class="navbar navbar-expand navbar-light topbar mb-4 static-top fluxx-topbar">
                    <button id="sidebarToggleTop" class="btn btn-link d-md-none rounded-circle mr-2" type="button">
                        <i class="fa fa-bars"></i>
                    </button>

                    <div class="fluxx-page-title d-none d-sm-flex">
                        <span class="fx-brand-chip">Fluxx ERP</span>
                        <div>
                            <span class="fx-topbar-eyebrow">Enterprise</span>
                            <strong class="fx-topbar-title">@(ViewData["Title"] ?? "Command Center")</strong>
                        </div>
                    </div>

                    <div class="fx-topbar-search d-none d-lg-flex ml-4">
                        <i class="fas fa-search"></i>
                        <input type="search" class="form-control" placeholder="Search modules, items, documents…" disabled title="Coming soon" />
                    </div>

                    <ul class="navbar-nav ml-auto align-items-center">
                        @if (canAccess("Approvals"))
                        {
                            <li class="nav-item mx-1">
                                <a class="fx-topbar-icon-btn @(pendingApprovals > 0 ? "has-alert" : "")"
                                   asp-controller="Approval" asp-action="Inbox"
                                   title="@(pendingApprovals > 0 ? pendingApprovals + " pending approval(s)" : "Approval inbox")">
                                    <i class="fas fa-bell"></i>
                                    @if (pendingApprovals > 0)
                                    {
                                        <span class="fx-alert-dot">@(pendingApprovals > 9 ? "9+" : pendingApprovals.ToString())</span>
                                    }
                                </a>
                            </li>
                        }
                        @if (canAccess("Reports"))
                        {
                            <li class="nav-item d-none d-md-block mx-1">
                                <a class="fx-topbar-icon-btn" asp-controller="Reports" asp-action="Index" title="Business Reports">
                                    <i class="fas fa-chart-pie"></i>
                                </a>
                            </li>
                        }
                        <li class="nav-item dropdown no-arrow ml-2">
                            <a class="nav-link dropdown-toggle fx-user-chip" href="#" id="userDropdown" role="button"
                               data-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
                                <span class="fx-user-meta d-none d-lg-inline">
                                    <span class="fx-user-name">@(User?.Identity?.IsAuthenticated == true ? User.Identity.Name : "Guest")</span>
                                    <span class="fx-user-role">@userRole</span>
                                </span>
                                <span class="fluxx-avatar"><i class="fas fa-user"></i></span>
                            </a>
                            <div class="dropdown-menu dropdown-menu-right shadow animated--grow-in" aria-labelledby="userDropdown">
                                @if (User?.Identity?.IsAuthenticated == true)
                                {
                                    <div class="fx-user-dropdown-header">
                                        <div class="font-weight-bold">@(User.Identity.Name)</div>
                                        @if (!string.IsNullOrWhiteSpace(userEmail))
                                        {
                                            <div class="small text-muted">@userEmail</div>
                                        }
                                        <div class="small"><span class="badge badge-fx badge-fx-info">@userRole</span></div>
                                    </div>
                                    <div class="dropdown-divider"></div>
                                    @if (canAccess("Approvals"))
                                    {
                                        <a class="dropdown-item" asp-controller="Approval" asp-action="Inbox">
                                            <i class="fas fa-clipboard-check fa-sm fa-fw mr-2 text-gray-400"></i>
                                            My Approvals
                                            @if (pendingApprovals > 0)
                                            {
                                                <span class="badge badge-fx badge-fx-warning ml-1">@pendingApprovals</span>
                                            }
                                        </a>
                                    }
                                    @if (canAccess("Settings"))
                                    {
                                        <a class="dropdown-item" asp-controller="Settings" asp-action="Index">
                                            <i class="fas fa-cog fa-sm fa-fw mr-2 text-gray-400"></i>
                                            Settings
                                        </a>
                                        <div class="dropdown-divider"></div>
                                    }
                                    <a class="dropdown-item" asp-controller="Login" asp-action="Logout">
                                        <i class="fas fa-sign-out-alt fa-sm fa-fw mr-2 text-gray-400"></i>
                                        Sign Out
                                    </a>
                                }
                                else
                                {
                                    <a class="dropdown-item" asp-controller="Login" asp-action="Login">
                                        <i class="fas fa-sign-in-alt fa-sm fa-fw mr-2 text-gray-400"></i>
                                        Sign In
                                    </a>
                                }
                            </div>
                        </li>
                    </ul>
                </nav>

                <div class="container-fluid px-4 pb-4">
                    @{
                        var flashSuccess = TempData["Success"] as string;
                        var flashError = TempData["Error"] as string;
                        var flashWarning = TempData["Warning"] as string;
                        var flashDetail = TempData["DetailedError"] as string;
                        var flashCid = TempData["CorrelationId"] as string;
                    }
                    <div id="fxFlash" class="d-none"
                         data-success="@flashSuccess"
                         data-error="@flashError"
                         data-warning="@flashWarning"
                         data-detail="@flashDetail"
                         data-cid="@flashCid"></div>
                    @if (!string.IsNullOrWhiteSpace(flashDetail))
                    {
                        <div class="alert alert-danger fx-dev-error mb-3" role="alert">
                            <div class="d-flex justify-content-between align-items-start">
                                <strong>Development error detail</strong>
                                @if (!string.IsNullOrWhiteSpace(flashCid))
                                {
                                    <code>@flashCid</code>
                                }
                            </div>
                            <pre class="fx-error-dump mb-0 mt-2">@flashDetail</pre>
                        </div>
                    }
                    @RenderBody()
                </div>
            </div>

            <footer class="sticky-footer bg-white">
                <div class="container my-auto">
                    <div class="copyright text-center my-auto">
                        <span>Fluxx ERP · Multi-user enterprise platform</span>
                    </div>
                </div>
            </footer>
        </div>
    </div>

    <a class="scroll-to-top rounded" href="#page-top"><i class="fas fa-angle-up"></i></a>

    <script src="~/vendor/jquery/jquery.min.js"></script>
    <script src="~/vendor/bootstrap/js/bootstrap.bundle.min.js"></script>
    <script src="~/vendor/jquery-easing/jquery.easing.min.js"></script>
    <script src="~/js/sb-admin-2.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script src="~/js/fluxx-required-warning.js" asp-append-version="true"></script>
    <partial name="_ValidationScriptsPartial" />
    <script>
        (function () {
            var el = document.getElementById('fxFlash');
            if (!el || typeof Swal === 'undefined') return;
            var ok = el.getAttribute('data-success');
            var err = el.getAttribute('data-error');
            var warn = el.getAttribute('data-warning');
            if (ok) {
                Swal.fire({
                    icon: 'success',
                    title: 'Done',
                    text: ok,
                    confirmButtonColor: '#0d9488',
                    timer: 3200,
                    timerProgressBar: true
                });
            }
            if (warn) {
                Swal.fire({
                    icon: 'warning',
                    title: 'Warning',
                    text: warn,
                    confirmButtonText: 'CLOSE',
                    confirmButtonColor: '#f59e0b',
                    iconColor: '#f59e0b'
                });
            }
            if (err) {
                Swal.fire({
                    icon: 'error',
                    title: 'Something went wrong',
                    text: err,
                    confirmButtonColor: '#0d9488'
                });
            }
        })();
    </script>
    @RenderSection("Scripts", required: false)
</body>
</html>
