@model ErrorViewModel
@{
    ViewData["Title"] = "Error";
    Layout = "_Layout";
}

<div class="page-hero">
    <div>
        <h1 class="text-danger">Something went wrong</h1>
        <p>An error occurred while processing your request.</p>
    </div>
</div>

<div class="card fx-card">
    <div class="card-body">
        @if (Model.ShowCorrelationId)
        {
            <p class="mb-2">
                <strong>Reference ID:</strong>
                <code>@Model.CorrelationId</code>
                <span class="text-muted small ml-2">Use this ID when searching logs.</span>
            </p>
        }
        @if (Model.ShowRequestId)
        {
            <p class="mb-2">
                <strong>Request ID:</strong> <code>@Model.RequestId</code>
            </p>
        }

        @if (Model.ShowDetails)
        {
            <hr />
            <h5 class="text-danger">Development details</h5>
            @if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
            {
                <p><strong>Message:</strong> @Model.ErrorMessage</p>
            }
            @if (!string.IsNullOrWhiteSpace(Model.DetailedError))
            {
                <pre class="fx-error-dump">@Model.DetailedError</pre>
            }
        }
        else
        {
            <p class="text-muted mb-0">
                The full error was logged. Share the reference ID above with support if the problem continues.
            </p>
        }
    </div>
</div>
