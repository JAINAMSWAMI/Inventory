<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>@ViewData["Title"] · Fluxx Inventory</title>
    <link href="~/vendor/fontawesome-free/css/all.min.css" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Syne:wght@600;700;800&display=swap" rel="stylesheet">
    <link href="~/css/sb-admin-2.min.css" rel="stylesheet">
    <link href="~/css/fluxx-auth.css" rel="stylesheet">
</head>
<body class="auth-body">
    <main class="auth-shell">
        <section class="auth-brand-panel">
            <a class="auth-logo" asp-controller="Login" asp-action="Login">
                <span class="auth-logo-mark"><i class="fas fa-cube"></i></span>
                <span>Fluxx</span>
            </a>

            <div class="auth-brand-copy">
                <span class="auth-eyebrow">Inventory intelligence</span>
                <h1>Stock clarity.<br>Smarter operations.</h1>
                <p>Manage products, suppliers, warehouses and shipments from one reliable workspace.</p>
            </div>

            <div class="auth-feature-list">
                <span><i class="fas fa-check"></i> Real-time stock visibility</span>
                <span><i class="fas fa-check"></i> Stored-procedure powered</span>
                <span><i class="fas fa-check"></i> Secure team access</span>
            </div>
        </section>

        <section class="auth-form-panel">
            <div class="auth-form-wrap">
                @RenderBody()
            </div>
        </section>
    </main>

    <script src="~/vendor/jquery/jquery.min.js"></script>
    <script src="~/vendor/bootstrap/js/bootstrap.bundle.min.js"></script>
    <partial name="_ValidationScriptsPartial" />
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
